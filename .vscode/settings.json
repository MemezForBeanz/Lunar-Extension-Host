{
    // CMake Tools: use CMakePresets.json. Each OS sees only its own presets
    // (Windows: dev -> build/win, release -> build/rel; Linux: linux-dev ->
    // build/linux, linux-release -> build/linux-rel). On Windows, cmake lives only
    // in MSYS2: the Windows presets name it (cmakeExecutable) and put MSYS2 on PATH,
    // so nothing here is OS-specific.
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // C/C++ IntelliSense from the CMake-generated compile_commands.json (which
    // carries the compiler for each OS).
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    // Lua language server: LuaJIT, with the host-injected globals.
    "Lua.runtime.version": "LuaJIT",
    "Lua.workspace.library": ["${workspaceFolder}/src/lua"],
    "Lua.diagnostics.globals": ["iup", "LUNAR_EXE_DIR", "LUNAR_EXE_PATH", "LUNAR_PID", "LUNAR_DEV_BUILD"],

    // Tasks and terminals find gcc, cmake, make, python and gdb from MSYS2.
    "terminal.integrated.env.windows": {
        "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}",
        "LUNAR_REPO": "${workspaceFolder}"
    },
    "terminal.integrated.env.linux": {
        "LUNAR_REPO": "${workspaceFolder}"
    },

    "files.exclude": {
        "build/": true,
        "dist/": true
    }
}
