{
    // Ctrl+Shift+B builds (dev). "Tasks: Run Task" lists the rest; "Tasks: Run Test
    // Task" runs the busted suite. On Windows every task finds MSYS2 tools via the
    // PATH below; on Linux the tasks use the linux-* presets and scripts/dev.sh.
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] },
            "env": {
                "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}",
                "LUNAR_REPO": "${workspaceFolder}"
            }
        }
    },
    "linux": {
        "options": {
            "shell": { "executable": "/bin/bash", "args": ["-c"] },
            "env": { "LUNAR_REPO": "${workspaceFolder}" }
        }
    },
    "tasks": [
        {
            "label": "Run Lunar with all project extensions (dev)",
            "detail": "Loads extensions/ and built-in plugins directly from source. Starts a private local media server; closing the desktop stops it. Windows dev build.",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/run-dev-extensions.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Run Lunar with demo data (dev)",
            "detail": "Interactive UI capture fixtures: leaves Lunar open to explore populated pages. Help > Reload demo data restores the fixtures.",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/run-gui-tests.ps1"],
            "options": {
                "env": {
                    "LUNAR_TEST_SCRIPTS": "ui_demo.lua",
                    "LUNAR_TEST_OVERRIDE": "",
                    "LUNAR_TEST_ALL_PACKS": "${input:testAllOrgPacks}",
                    "LUNAR_TEST_PACKS_DIR": "${input:orgPacksDir}"
                }
            },
            "linux": {
                "command": "/bin/bash",
                "args": ["${workspaceFolder}/scripts/run-gui-tests.sh"]
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Run Lunar with a test script (dev)",
            "detail": "Choose a script, or override the selection by typing a filename. Scripts own the GUI lifecycle; close interactive harnesses to finish.",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/run-gui-tests.ps1"],
            "options": {
                "env": {
                    "LUNAR_TEST_SCRIPTS": "${input:testScript}",
                    "LUNAR_TEST_OVERRIDE": "${input:testScriptOverride}",
                    "LUNAR_TEST_ALL_PACKS": "${input:testAllOrgPacks}",
                    "LUNAR_TEST_PACKS_DIR": "${input:orgPacksDir}"
                }
            },
            "linux": {
                "command": "/bin/bash",
                "args": ["${workspaceFolder}/scripts/run-gui-tests.sh"]
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Run Lunar with multiple test scripts (dev)",
            "detail": "Run comma- or semicolon-separated scripts in order, each in a fresh Lunar process. Close interactive harnesses to advance.",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/run-gui-tests.ps1"],
            "options": {
                "env": {
                    "LUNAR_TEST_SCRIPTS": "${input:testScripts}",
                    "LUNAR_TEST_OVERRIDE": "",
                    "LUNAR_TEST_ALL_PACKS": "${input:testAllOrgPacks}",
                    "LUNAR_TEST_PACKS_DIR": "${input:orgPacksDir}"
                }
            },
            "linux": {
                "command": "/bin/bash",
                "args": ["${workspaceFolder}/scripts/run-gui-tests.sh"]
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Build (dev)",
            "type": "shell",
            "command": "cmake --preset dev; if ($?) { cmake --build --preset dev }",
            "linux": { "command": "cmake --preset linux-dev && cmake --build --preset linux-dev" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Build (release)",
            "type": "shell",
            "command": "cmake --preset release; if ($?) { cmake --build --preset release }",
            "linux": { "command": "cmake --preset linux-release && cmake --build --preset linux-release" },
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Run Lunar (dev)",
            "type": "process",
            "command": "${workspaceFolder}/build/win/bin/Lunar.exe",
            "options": { "cwd": "${workspaceFolder}/build/win/bin" },
            "linux": {
                "command": "${workspaceFolder}/build/linux/bin/lunar",
                "options": { "cwd": "${workspaceFolder}/build/linux/bin" }
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Run Lunar (dev, no build)",
            "type": "process",
            "command": "${workspaceFolder}/build/win/bin/Lunar.exe",
            "options": { "cwd": "${workspaceFolder}/build/win/bin" },
            "linux": {
                "command": "${workspaceFolder}/build/linux/bin/lunar",
                "options": { "cwd": "${workspaceFolder}/build/linux/bin" }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Lunar with an org pack (dev)",
            "detail": "Loads org packs from a folder (LUNAR_PROFILE_DIR) and selects one by id (LUNAR_PROFILE; empty = match by DNS domain). Dev builds only.",
            "type": "process",
            "command": "${workspaceFolder}/build/win/bin/Lunar.exe",
            "options": {
                "cwd": "${workspaceFolder}/build/win/bin",
                "env": {
                    "LUNAR_PROFILE_DIR": "${input:orgPacksDir}",
                    "LUNAR_PROFILE": "${input:orgPack}"
                }
            },
            "linux": {
                "command": "${workspaceFolder}/build/linux/bin/lunar",
                "options": {
                    "cwd": "${workspaceFolder}/build/linux/bin",
                    "env": {
                        "LUNAR_PROFILE_DIR": "${input:orgPacksDir}",
                        "LUNAR_PROFILE": "${input:orgPack}"
                    }
                }
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Run Lunar with all org packs (dev)",
            "detail": "Loads every valid pack from LUNAR_PROFILE_DIR, sorted by id. Dev builds only.",
            "type": "process",
            "command": "${workspaceFolder}/build/win/bin/Lunar.exe",
            "options": {
                "cwd": "${workspaceFolder}/build/win/bin",
                "env": {
                    "LUNAR_PROFILE_DIR": "${input:orgPacksDir}",
                    "LUNAR_PROFILE": "*"
                }
            },
            "linux": {
                "command": "${workspaceFolder}/build/linux/bin/lunar",
                "options": {
                    "cwd": "${workspaceFolder}/build/linux/bin",
                    "env": {
                        "LUNAR_PROFILE_DIR": "${input:orgPacksDir}",
                        "LUNAR_PROFILE": "*"
                    }
                }
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Run Lunar (release)",
            "type": "process",
            "command": "${workspaceFolder}/build/rel/bin/Lunar.exe",
            "options": { "cwd": "${workspaceFolder}/build/rel/bin" },
            "linux": {
                "command": "${workspaceFolder}/build/linux-rel/bin/lunar",
                "options": { "cwd": "${workspaceFolder}/build/linux-rel/bin" }
            },
            "dependsOn": "Build (release)",
            "problemMatcher": []
        },
        {
            "label": "Test (busted)",
            "type": "shell",
            "command": "powershell -NoProfile -File scripts/test.ps1",
            "linux": { "command": "scripts/dev.sh test" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Lint (luacheck)",
            "type": "shell",
            "command": "powershell -NoProfile -File scripts/lint.ps1",
            "linux": { "command": "scripts/dev.sh lint" },
            "problemMatcher": {
                "owner": "luacheck",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^\\s*(.+?):(\\d+):(\\d+): (.*)$",
                    "file": 1, "line": 2, "column": 3, "message": 4
                }
            }
        },
        {
            "label": "Docs check (ldoc)",
            "type": "shell",
            "command": "powershell -NoProfile -File scripts/docs.ps1 -OutDir dist/docs-ci -Check",
            "linux": { "command": "scripts/dev.sh docs --check --out dist/docs-ci" },
            "problemMatcher": []
        },
        {
            "label": "Check all (test + lint + docs)",
            "dependsOrder": "sequence",
            "dependsOn": ["Test (busted)", "Lint (luacheck)", "Docs check (ldoc)"],
            "problemMatcher": []
        },
        {
            "label": "Harness: process contract",
            "detail": "End-to-end check of the native process module against spec/fixtures/fake_engine.py.",
            "type": "shell",
            "command": "$env:LUA_PATH='src/lua/?.lua;vendor/luarocks-tree/share/lua/5.1/?.lua;;'; build/win/bin/LunarCLI.exe scripts/process_check.lua C:/msys64/mingw64/bin/python.exe",
            "linux": {
                "command": "LUA_PATH='src/lua/?.lua;vendor/luarocks-tree/share/lua/5.1/?.lua;vendor/copas/?.lua;;' build/linux/bin/lunar-cli scripts/process_check.lua /usr/bin/python3"
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Harness: compositor goldens",
            "detail": "Renders the golden scenes with the native compositor and an independent Lua reference; they must match byte for byte.",
            "type": "shell",
            "command": "$env:LUA_PATH='src/lua/?.lua;spec/support/?.lua;vendor/luarocks-tree/share/lua/5.1/?.lua;;'; build/win/bin/LunarCLI.exe scripts/compositor_check.lua",
            "linux": {
                "command": "LUA_PATH='src/lua/?.lua;spec/support/?.lua;vendor/luarocks-tree/share/lua/5.1/?.lua;;' build/linux/bin/lunar-cli scripts/compositor_check.lua"
            },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Harness: motion",
            "detail": "Native motion layer against a real window (exits when done). Windows only until the compositor backends land.",
            "type": "shell",
            "command": "$p = Start-Process build/win/bin/Lunar.exe -ArgumentList \"`\"${workspaceFolder}/scripts/motion_check.lua`\"\",'--batch' -WorkingDirectory build/win/bin -RedirectStandardOutput \"$env:TEMP/motion_check.out\" -PassThru -Wait; Get-Content \"$env:TEMP/motion_check.out\"",
            "linux": { "command": "echo 'The motion harness needs the Win32 overlay; it runs on Windows only for now.'" },
            "dependsOn": "Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Clean (build trees)",
            "type": "shell",
            "command": "Remove-Item -Recurse -Force build/win, build/rel -ErrorAction SilentlyContinue",
            "linux": { "command": "rm -rf build/linux build/linux-rel" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "testScript",
            "type": "pickString",
            "description": "Lua script from scripts/ (use the next prompt to type a different filename)",
            "default": "ui_capture.lua",
            "options": [
                "compositor_check.lua",
                "gtk_compositor_probe.lua",
                "gtk_overlay_probe.lua",
                "layout_dump.lua",
                "ldoc_wiki.lua",
                "lsp_check.lua",
                "luarocks-config.lua",
                "machine_check.lua",
                "motion_check.lua",
                "process_check.lua",
                "process_host_death_helper.lua",
                "scrim_check.lua",
                "tls_check.lua",
                "ui_capture.lua",
                "ui_demo.lua",
                "ui_fixtures.lua",
                "ui_fixtures_net.lua",
                "win32_overlay_probe.lua"
            ]
        },
        {
            "id": "testScriptOverride",
            "type": "promptString",
            "description": "Optional script filename (with or without .lua); leave blank to use the dropdown selection",
            "default": ""
        },
        {
            "id": "testScripts",
            "type": "promptString",
            "description": "Script filenames from scripts/, separated by commas or semicolons (optional .lua suffix)",
            "default": "layout_dump.lua, scrim_check.lua"
        },
        {
            "id": "testAllOrgPacks",
            "type": "pickString",
            "description": "Load all org packs? The following folder prompt is used only for Yes.",
            "options": [
                { "label": "No — normal org-pack selection", "value": "no" },
                { "label": "Yes — load all org packs", "value": "yes" }
            ],
            "default": "no"
        },
        {
            "id": "orgPacksDir",
            "type": "promptString",
            "description": "Folder holding org packs (each a subfolder with profile.json)",
            "default": "${workspaceFolder}/../lunar-orgpacks"
        },
        {
            "id": "orgPack",
            "type": "promptString",
            "description": "Pack id to select (empty: match by the machine's DNS domain)",
            "default": ""
        }
    ]
}
