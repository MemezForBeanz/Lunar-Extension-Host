+/* Lunar fork: the lit corners of a rounded border. Each corner takes a few 1px strokes of
+ * the sheen colour, each shorter than the last, so the light builds up on the arc and fades
+ * out along both sides of the box. Returns 0 when there is no GDI+ path to draw with. */
+IUP_SDK_API int iupdrvDrawFlatCornerSheen(IdrawCanvas* dc, int x1, int y1, int x2, int y2,
+                                          int radius, long color)
+{
+  static const float reach[5] = { 3.2f, 2.4f, 1.7f, 1.0f, 0.4f };   /* tail length, in radii */
+  dummy_GpGraphics* graphics = NULL;
+  dummy_GpPen* pen = NULL;
+  float l, t, r, b, d, rad, room_x, room_y;
+  int i;
+
+  if (dc->wdl_gc || !gdix_enabled()) return 0;
+
+  iupDrawCheckSwapCoord(x1, x2);
+  iupDrawCheckSwapCoord(y1, y2);
+
+  l = (float)x1; t = (float)y1; r = (float)x2; b = (float)y2;
+  rad = (float)radius;
+  if (rad > (r - l) / 2.0f) rad = (r - l) / 2.0f;
+  if (rad > (b - t) / 2.0f) rad = (b - t) / 2.0f;
+  if (rad < 1.0f) return 1;
+  d = rad * 2.0f;
+  room_x = (r - l) / 2.0f - rad;   /* a tail stops at the middle of its side */
+  room_y = (b - t) / 2.0f - rad;
+
+  if (gdix_vtable->fn_CreateFromHDC(dc->hBitmapDC, &graphics) != 0 || !graphics) return 0;
+  gdix_vtable->fn_SetSmoothingMode(graphics, dummy_SmoothingModeAntiAlias);
+  /* Translucent, so the strokes add up: brightest on the arc, and each tail fades out. */
+  gdix_vtable->fn_CreatePen1(iupColor2ARGB(iupDrawColor(iupDrawRed(color), iupDrawGreen(color), iupDrawBlue(color), 26)),
+                             1.0f, dummy_UnitPixel, &pen);
+
+  if (pen)
+  {
+    for (i = 0; i < 5; i++)
+    {
+      float tx = rad * reach[i], ty = tx;
+      if (tx > room_x) tx = room_x;
+      if (ty > room_y) ty = room_y;
+
+      gdix_vtable->fn_DrawArc(graphics, pen, l,     t,     d, d, 180.0f, 90.0f);
+      gdix_vtable->fn_DrawArc(graphics, pen, r - d, t,     d, d, 270.0f, 90.0f);
+      gdix_vtable->fn_DrawArc(graphics, pen, r - d, b - d, d, d,   0.0f, 90.0f);
+      gdix_vtable->fn_DrawArc(graphics, pen, l,     b - d, d, d,  90.0f, 90.0f);
+
+      gdix_vtable->fn_DrawLine(graphics, pen, l + rad, t, l + rad + tx, t);
+      gdix_vtable->fn_DrawLine(graphics, pen, r - rad, t, r - rad - tx, t);
+      gdix_vtable->fn_DrawLine(graphics, pen, l + rad, b, l + rad + tx, b);
+      gdix_vtable->fn_DrawLine(graphics, pen, r - rad, b, r - rad - tx, b);
+      gdix_vtable->fn_DrawLine(graphics, pen, l, t + rad, l, t + rad + ty);
+      gdix_vtable->fn_DrawLine(graphics, pen, r, t + rad, r, t + rad + ty);
+      gdix_vtable->fn_DrawLine(graphics, pen, l, b - rad, l, b - rad - ty);
+      gdix_vtable->fn_DrawLine(graphics, pen, r, b - rad, r, b - rad - ty);
+    }
+    gdix_vtable->fn_DeletePen(pen);
+  }
+
+  gdix_vtable->fn_DeleteGraphics(graphics);
+  return 1;
+}
