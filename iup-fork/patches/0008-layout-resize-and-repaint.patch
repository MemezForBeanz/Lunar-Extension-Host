+    win_layout_dirty = dirty;
+    win_layout_dirty_max = max;
+  }
+  win_layout_dirty[win_layout_dirty_count].hwnd = hwnd;
+  win_layout_dirty[win_layout_dirty_count].flags = flags;
+  win_layout_dirty_count++;
+}
+
+static void winLayoutFlushDirty(void)
+{
+  int i;
+  for (i = 0; i < win_layout_dirty_count; i++)
+  {
+    HWND hwnd = win_layout_dirty[i].hwnd;
+    if (!IsWindow(hwnd))
+      continue;
+
+    /* Nearly every flat control is a bare leaf, and has no frame or subtree to walk. */
+    if (win_layout_dirty[i].flags == WIN_LAYOUT_REDRAW_MOVED && !GetWindow(hwnd, GW_CHILD) &&
