+/* Lunar fork: one backbuffer for every paint, and a DIB rather than a device bitmap.
+ *
+ * Each paint used to create, select and delete a bitmap the size of its control. Worse, GDI+
+ * cannot touch a device bitmap directly, so every antialiased primitive read its destination
+ * back through StretchBlt and wrote it out again. On a resize, where every control repaints,
+ * that was most of the cost of a frame. GDI+ writes straight into a DIB section, and painting
+ * is strictly one control at a time, so they can all share one that only ever grows. A paint
+ * that starts inside another paint gets a bitmap of its own. */
+typedef struct _IwinDrawBack
+{
+  HDC hDC;
+  HBITMAP hBitmap, hOldBitmap;
+  int w, h, busy;
+} IwinDrawBack;
+
+static IwinDrawBack win_draw_back = { NULL, NULL, NULL, 0, 0, 0 };
+
+static HBITMAP winDrawCreateDIB(int w, int h)
+{
+  BITMAPINFO bmi;
+  void* bits = NULL;
+
+  memset(&bmi, 0, sizeof(bmi));
+  bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+  bmi.bmiHeader.biWidth = w > 0 ? w : 1;
+  bmi.bmiHeader.biHeight = -(h > 0 ? h : 1);  /* top-down */
+  bmi.bmiHeader.biPlanes = 1;
+  bmi.bmiHeader.biBitCount = 32;
+  bmi.bmiHeader.biCompression = BI_RGB;
+  return CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, &bits, NULL, 0);
+}
+
+static int winDrawBackFits(int w, int h)
+{
+  IwinDrawBack* back = &win_draw_back;
+
+  if (!back->hDC)
+    back->hDC = CreateCompatibleDC(NULL);
+  if (!back->hDC)
+    return 0;
+
+  if (w > back->w || h > back->h)
+  {
+    /* Grows in steps, so a window being dragged wider does not reallocate on every pixel. */
+    int new_w = (iupMAX(w, back->w) + 255) & ~255;
+    int new_h = (iupMAX(h, back->h) + 255) & ~255;
+    HBITMAP hBitmap = winDrawCreateDIB(new_w, new_h);
+    if (!hBitmap)
+      return 0;
+
+    if (back->hBitmap)
+    {
+      SelectObject(back->hDC, back->hOldBitmap);
+      DeleteObject(back->hBitmap);
+    }
+    back->hBitmap = hBitmap;
+    back->hOldBitmap = SelectObject(back->hDC, hBitmap);
+    back->w = new_w;
+    back->h = new_h;
+  }
+  return 1;
+}
+
+static void winDrawBackFree(void)
+{
+  IwinDrawBack* back = &win_draw_back;
+  if (back->hBitmap)
+  {
+    SelectObject(back->hDC, back->hOldBitmap);
+    DeleteObject(back->hBitmap);
+  }
+  if (back->hDC)
+    DeleteDC(back->hDC);
+  memset(back, 0, sizeof(IwinDrawBack));
+}
+
+static void winDrawAttachBitmap(IdrawCanvas* dc)
+{
+  if (dc->shared_back || (!win_draw_back.busy && winDrawBackFits(dc->w, dc->h)))
+  {
+    if (dc->shared_back && !winDrawBackFits(dc->w, dc->h))
+    {
+      /* could not grow: paint what fits rather than fail */
+      dc->w = iupMIN(dc->w, win_draw_back.w);
+      dc->h = iupMIN(dc->h, win_draw_back.h);
+    }
+    win_draw_back.busy = 1;
+    dc->shared_back = 1;
+    dc->hBitmapDC = win_draw_back.hDC;
+    dc->hBitmap = win_draw_back.hBitmap;
+    SelectClipRgn(dc->hBitmapDC, NULL);  /* the last control may have left one */
+  }
+  else
+  {
+    dc->hBitmap = winDrawCreateDIB(dc->w, dc->h);
+    dc->hBitmapDC = CreateCompatibleDC(dc->hDC);
+    dc->hOldBitmap = SelectObject(dc->hBitmapDC, dc->hBitmap);
+  }
+
+  SetBkMode(dc->hBitmapDC, TRANSPARENT);
+  SetTextAlign(dc->hBitmapDC, TA_TOP|TA_LEFT);
+}
+
+static void winDrawDetachBitmap(IdrawCanvas* dc)
+{
+  if (dc->shared_back)
+    return;
+
+  SelectObject(dc->hBitmapDC, dc->hOldBitmap);
+  DeleteObject(dc->hBitmap);
+  DeleteDC(dc->hBitmapDC);  /* to match CreateCompatibleDC */
+}
