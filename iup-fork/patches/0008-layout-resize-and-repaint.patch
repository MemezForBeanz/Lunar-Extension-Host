+/* Lunar fork: one layout pass, one change on screen.
+ *
+ * Moving a window under a visible parent is the most expensive thing a layout does. For
+ * each child the kernel recomputes the visible regions of its siblings, carries the valid
+ * bits across and invalidates what was exposed: about half a millisecond a window, and
+ * DeferWindowPos only groups the calls without avoiding any of that. A resize that moved
+ * seventy windows spent 34 ms there, against 7 ms measuring the whole tree.
+ *
+ * So a pass queues its moves, and commits them with the top-level window's redraw off.
+ * WM_SETREDRAW clears WS_VISIBLE internally, nothing underneath counts as on screen for
+ * the length of the commit, and the kernel has nothing to recompute: the same moves take
+ * 6 ms. The price is that it also invalidates nothing, so the commit does it afterwards,
+ * for the windows that really moved and the parents they moved in. A window the pass left
+ * alone keeps its pixels, which is what makes a sash drag cheap in the other panes.
+ *
+ * WM_SETREDRAW is not free of side effects. Turning it off first validates the whole tree,
+ * so a repaint still pending anywhere is thrown away; and while it is off, invalidating
+ * or hiding a window does nothing at all. Two tab strips switched in a row left the first
+ * strip showing the previous page for good. So what is pending is recorded first
+ * (winLayoutKeepPending), and redraws and visibility changes that arrive during the
+ * commit join the list (see iupdrvPostRedraw, iupdrvRedrawNow, iupdrvSetVisible). */
+typedef struct _IwinLayoutMove
+{
+  HWND hwnd, parent;
+  int x, y, w, h;
+  UINT flags;
+} IwinLayoutMove;
+
+/* Below this it is not worth a round trip: the moves are few and the kernel does the rest. */
+#define WIN_LAYOUT_SUSPEND_MIN 4
+
+static IwinLayoutMove* win_layout_moves = NULL;
+static int win_layout_count = 0, win_layout_max = 0, win_layout_depth = 0;
+
+/* What the commit under way has to repaint. A move can run a resize callback that starts a
+   layout pass of its own, so a nested commit adds to this instead of repainting early. */
+typedef struct _IwinLayoutDirty
+{
+  HWND hwnd;
+  UINT flags;
+} IwinLayoutDirty;
+
+static HWND win_layout_suspended = NULL;
+static IwinLayoutDirty* win_layout_dirty = NULL;
+static int win_layout_dirty_count = 0, win_layout_dirty_max = 0;
+
+#define WIN_LAYOUT_REDRAW_MOVED  (RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN)
+#define WIN_LAYOUT_REDRAW_PARENT (RDW_INVALIDATE | RDW_ERASE | RDW_NOCHILDREN)
+#define WIN_LAYOUT_REDRAW_POST   (RDW_ERASE | RDW_INVALIDATE | RDW_INTERNALPAINT)
+
+static void winLayoutMarkDirty(HWND hwnd, UINT flags)
+{
+  if (win_layout_dirty_count == win_layout_dirty_max)
+  {
+    int max = win_layout_dirty_max ? win_layout_dirty_max * 2 : 128;
+    IwinLayoutDirty* dirty = (IwinLayoutDirty*)realloc(win_layout_dirty, max * sizeof(IwinLayoutDirty));
+    if (!dirty)
