+}
+
+static BOOL CALLBACK winLayoutKeepPendingProc(HWND hwnd, LPARAM lParam)
+{
+  (void)lParam;
+  if (GetUpdateRect(hwnd, NULL, FALSE))
+    winLayoutMarkDirty(hwnd, WIN_LAYOUT_REDRAW_PARENT);
+  return TRUE;
+}
+
+static void winLayoutKeepPending(HWND root)
+{
+  winLayoutKeepPendingProc(root, 0);
+  EnumChildWindows(root, winLayoutKeepPendingProc, 0);  /* walks the whole tree */
+}
+
+/* The top-level window to suspend for these moves, if it is worth it and they share one. */
+static HWND winLayoutCommitRoot(IwinLayoutMove* moves, int count)
+{
+  HWND root;
+  int i;
+
+  if (win_layout_suspended || count < WIN_LAYOUT_SUSPEND_MIN)
+    return NULL;
+
+  root = GetAncestor(moves[0].parent, GA_ROOT);
+  if (!root || !IsWindowVisible(root))
+    return NULL;
+
+  for (i = 1; i < count; i++)
+  {
+    if (moves[i].parent != moves[i - 1].parent && GetAncestor(moves[i].parent, GA_ROOT) != root)
+      return NULL;
+  }
+  return root;
+}
+
+static void winLayoutCommit(IwinLayoutMove* moves, int count)
+{
+  HWND root = winLayoutCommitRoot(moves, count);
+  int i, j;
+
+  if (root)
+  {
+    winLayoutKeepPending(root);
+    SendMessage(root, WM_SETREDRAW, FALSE, 0);
+    win_layout_suspended = root;
+  }
+
+  for (i = 0; i < count; i++)
+  {
+    HWND parent = moves[i].parent;
+    HDWP hdwp;
+    int members = 0;
+
+    if (!moves[i].hwnd)
+      continue;  /* went with an earlier parent */
+
+    for (j = i; j < count; j++)
+    {
+      if (moves[j].hwnd && moves[j].parent == parent)
+        members++;
+    }
+
+    hdwp = members > 1 ? BeginDeferWindowPos(members) : NULL;
+    for (j = i; j < count; j++)
+    {
+      IwinLayoutMove* move = moves + j;
+      if (!move->hwnd || move->parent != parent)
+        continue;
+
+      if (IsWindow(move->hwnd))
+      {
+        if (hdwp)
+          hdwp = DeferWindowPos(hdwp, move->hwnd, NULL, move->x, move->y, move->w, move->h, move->flags);
+        if (!hdwp)  /* a single window, or a batch the system gave up on */
+          SetWindowPos(move->hwnd, NULL, move->x, move->y, move->w, move->h, move->flags);
+
+        if (win_layout_suspended)
+          winLayoutMarkDirty(move->hwnd, WIN_LAYOUT_REDRAW_MOVED);
+      }
+      move->hwnd = NULL;
+    }
+
+    if (hdwp)
+      EndDeferWindowPos(hdwp);
+
+    if (win_layout_suspended)
+      winLayoutMarkDirty(parent, WIN_LAYOUT_REDRAW_PARENT);  /* what the children uncovered */
+  }
+
+  if (root)
+  {
+    /* Back on first: a window that is not visible discards RedrawWindow. */
+    win_layout_suspended = NULL;
+    SendMessage(root, WM_SETREDRAW, TRUE, 0);
+    winLayoutFlushDirty();
+  }
+}
+
+void iupwinLayoutBatchBegin(void)
+{
+  win_layout_depth++;
+}
+
+void iupwinLayoutBatchEnd(void)
+{
+  win_layout_depth--;
+  if (win_layout_depth == 0 && win_layout_count > 0)
+  {
+    /* The commit sends WM_SIZE, and a resize callback can start a layout pass of its own. */
+    IwinLayoutMove* moves = win_layout_moves;
+    int count = win_layout_count;
+    win_layout_moves = NULL;
+    win_layout_count = win_layout_max = 0;
+    winLayoutCommit(moves, count);
+    free(moves);
+  }
+}
