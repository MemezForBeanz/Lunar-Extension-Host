diff --git a/src/iup_flatlist.c b/src/iup_flatlist.c
index a24f2d3..231fc46 100644
--- a/src/iup_flatlist.c
+++ b/src/iup_flatlist.c
@@ -302,7 +302,10 @@ static int iFlatListRedraw_CB(Ihandle* ih)
 
   iupdrvDrawGetSize(dc, &width, &height);
 
-  iupFlatDrawBox(dc, border_width, width - border_width - 1, border_width, height - border_width - 1, background_color, background_color, 1);
+  /* Lunar fork: honors CORNERRADIUS (rounded list body), like the other flat
+     controls. Items are drawn after this fill, so with a small radius only the
+     background's corner pixels round; rows never reach into the border. */
+  iupFlatDrawBoxAttrib(ih, dc, border_width, width - border_width - 1, border_width, height - border_width - 1, background_color, background_color, 1);
 
   if (back_image)
   {
@@ -372,7 +375,7 @@ static int iFlatListRedraw_CB(Ihandle* ih)
   if (border_width)
   {
     char* bordercolor = iupAttribGetStr(ih, "BORDERCOLOR");
-    iupFlatDrawBorder(dc, 0, width - 1,
+    iupFlatDrawBorderAttrib(ih, dc, 0, width - 1,
                           0, height - 1,
                           border_width, bordercolor, background_color, active);
   }
@@ -1313,6 +1316,10 @@ static int iFlatListSetValueAttrib(Ihandle* ih, const char* value)
     /* un-select all */
     for (i = 0; i < count; i++)
       items[i].selected = 0;
+    /* Lunar fork: keep the keyboard focus row inside the list, which may have
+       just shrunk (items are truncated before VALUE is cleared). */
+    if (ih->data->focus_pos > count)
+      ih->data->focus_pos = count;
   }
   else
   {
@@ -1349,6 +1356,13 @@ static int iFlatListSetValueAttrib(Ihandle* ih, const char* value)
 
         items[pos - 1].selected = 1;
         iupAttribSetInt(ih, "_IUPFLATLIST_LASTSELECTED", pos);
+        /* Lunar fork: keyboard navigation starts from the selected item, and the
+           list scrolls to it, as in a native list. Without this the first arrow
+           key after a programmatic VALUE moved from item 1 (or wherever the mouse
+           last was), and a dropdown opened at its old scroll position. */
+        ih->data->focus_pos = pos;
+        if (ih->handle)
+          iFlatListScrollFocusVisible(ih);
       }
     }
   }
@@ -1971,6 +1985,7 @@ Iclass* iupFlatListNewClass(void)
   iupClassRegisterAttribute(ic, "VALUE", iFlatListGetValueAttrib, iFlatListSetValueAttrib, NULL, NULL, IUPAF_NO_SAVE | IUPAF_NO_DEFAULTVALUE | IUPAF_NO_INHERIT);
   iupClassRegisterAttribute(ic, "VALUESTRING", iFlatListGetValueStringAttrib, iFlatListSetValueStringAttrib, NULL, NULL, IUPAF_NO_DEFAULTVALUE | IUPAF_NO_INHERIT);
 
+  iupClassRegisterAttribute(ic, "CORNERRADIUS", NULL, iFlatListSetAttribPostRedraw, NULL, NULL, IUPAF_NOT_MAPPED);  /* Lunar fork */
   iupClassRegisterAttribute(ic, "BORDERCOLOR", NULL, NULL, IUPAF_SAMEASSYSTEM, IUP_FLAT_BORDERCOLOR, IUPAF_DEFAULT);  /* inheritable */
   iupClassRegisterAttribute(ic, "BORDERWIDTH", iFlatListGetBorderWidthAttrib, iFlatListSetBorderWidthAttrib, IUPAF_SAMEASSYSTEM, "0", IUPAF_NOT_MAPPED);  /* inheritable */
   iupClassRegisterAttribute(ic, "FGCOLOR", NULL, iFlatListSetAttribPostRedraw, IUP_FLAT_FORECOLOR, NULL, IUPAF_NOT_MAPPED);  /* force the new default value */
