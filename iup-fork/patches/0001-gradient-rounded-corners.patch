+IUP_SDK_API int iupdrvDrawFlatRoundBox(IdrawCanvas* dc, int x1, int y1, int x2, int y2,
+                                       int radius, long color1, long color2, int has_gradient, int vertical)
+{
+  dummy_GpGraphics* graphics = NULL;
+  dummy_GpPath* path = NULL;
+  dummy_GpBrush* brush = NULL;
+  float fx, fy, fw, fh, fr;
+
+  if (dc->wdl_gc) return 0;       /* Direct2D active: let the caller's scanline path run */
+  if (!gdix_enabled()) return 0;  /* GDI+ unavailable */
+
+  iupDrawCheckSwapCoord(x1, x2);
+  iupDrawCheckSwapCoord(y1, y2);
+
+  fw = (float)(x2 - x1 + 1);
+  fh = (float)(y2 - y1 + 1);
+  if (fw <= 0.0f || fh <= 0.0f) return 1;
+  fx = (float)x1;
+  fy = (float)y1;
+  fr = (float)radius;
+  if (fr < 0.0f) fr = 0.0f;
+  if (fr > fw / 2.0f) fr = fw / 2.0f;
+  if (fr > fh / 2.0f) fr = fh / 2.0f;
+
+  if (gdix_vtable->fn_CreateFromHDC(dc->hBitmapDC, &graphics) != 0 || !graphics) return 0;
+  gdix_vtable->fn_SetSmoothingMode(graphics, dummy_SmoothingModeAntiAlias);
+
+  if (gdix_vtable->fn_CreatePath(dummy_FillModeWinding, &path) != 0 || !path)
+  {
+    gdix_vtable->fn_DeleteGraphics(graphics);
+    return 0;
+  }
+  iGdixAddRoundRectPath(path, fx, fy, fw, fh, fr);
+
+  if (has_gradient)
+  {
+    dummy_GpRectI rect;
+    rect.x = x1; rect.y = y1;
+    rect.w = (int)fw; rect.h = (int)fh;
+    /* LinearGradientMode: 0 = horizontal (left->right), 1 = vertical (top->bottom) */
+    gdix_vtable->fn_CreateLineBrushFromRectI(&rect, iupColor2ARGB(color1), iupColor2ARGB(color2),
+                                             vertical ? 1 : 0, 0, &brush);
+  }
+  else
+    gdix_vtable->fn_CreateSolidFill(iupColor2ARGB(color1), (dummy_GpSolidFill**)&brush);
+
+  if (brush)
+  {
+    gdix_vtable->fn_FillPath(graphics, brush, path);
+    gdix_vtable->fn_DeleteBrush(brush);
+  }
+
+  gdix_vtable->fn_DeletePath(path);
+  gdix_vtable->fn_DeleteGraphics(graphics);
+  return 1;
+}
+
+IUP_SDK_API int iupdrvDrawFlatRoundBorder(IdrawCanvas* dc, int x1, int y1, int x2, int y2,
+                                          int radius, int border_width, long color)
+{
+  dummy_GpGraphics* graphics = NULL;
+  dummy_GpPath* path = NULL;
+  dummy_GpPen* pen = NULL;
+  float fx, fy, fw, fh, fr, bw, half;
+
+  if (dc->wdl_gc) return 0;
+  if (!gdix_enabled()) return 0;
+  if (border_width <= 0) return 1;
+
+  iupDrawCheckSwapCoord(x1, x2);
+  iupDrawCheckSwapCoord(y1, y2);
+
+  bw = (float)border_width;
+  half = bw / 2.0f;
+
+  /* inset the geometry by half the (centered) stroke width so the border stays inside */
+  fx = (float)x1 + half;
+  fy = (float)y1 + half;
+  fw = (float)(x2 - x1 + 1) - bw;
+  fh = (float)(y2 - y1 + 1) - bw;
+  if (fw <= 0.0f || fh <= 0.0f) return 1;
+  fr = (float)radius - half;
+  if (fr < 0.0f) fr = 0.0f;
+  if (fr > fw / 2.0f) fr = fw / 2.0f;
+  if (fr > fh / 2.0f) fr = fh / 2.0f;
+
+  if (gdix_vtable->fn_CreateFromHDC(dc->hBitmapDC, &graphics) != 0 || !graphics) return 0;
+  gdix_vtable->fn_SetSmoothingMode(graphics, dummy_SmoothingModeAntiAlias);
+
+  if (gdix_vtable->fn_CreatePath(dummy_FillModeWinding, &path) != 0 || !path)
+  {
+    gdix_vtable->fn_DeleteGraphics(graphics);
+    return 0;
+  }
+  iGdixAddRoundRectPath(path, fx, fy, fw, fh, fr);
+
+  gdix_vtable->fn_CreatePen1(iupColor2ARGB(color), bw, dummy_UnitPixel, &pen);
+  if (pen)
+  {
+    gdix_vtable->fn_DrawPath(graphics, pen, path);
+    gdix_vtable->fn_DeletePen(pen);
+  }
+
+  gdix_vtable->fn_DeletePath(path);
+  gdix_vtable->fn_DeleteGraphics(graphics);
+  return 1;
+}
