+  {
+    gdix_vtable->fn_AddPathArc(path, x,         y,         d, d, 180.0f, 90.0f);  /* top-left     */
+    gdix_vtable->fn_AddPathArc(path, x + w - d, y,         d, d, 270.0f, 90.0f);  /* top-right    */
+    gdix_vtable->fn_AddPathArc(path, x + w - d, y + h - d, d, d,   0.0f, 90.0f);  /* bottom-right */
+    gdix_vtable->fn_AddPathArc(path, x,         y + h - d, d, d,  90.0f, 90.0f);  /* bottom-left  */
+  }
+  gdix_vtable->fn_ClosePathFigure(path);
+}
