+/* ==== Lunar fork additions: rounded-corner + gradient flat drawing =================== *
+ * All additive (new symbols only) so the prebuilt satellite archives stay ABI-safe.
+ * A scanline technique is used so a single cross-platform implementation covers every
+ * driver backend (WDL/Direct2D, GDI, GTK, X11) via the existing iupdrv primitives.    */
+
+/* Horizontal inset (in x) of a rounded rectangle boundary at scan row y. Returns how
+ * far the filled span must shrink on each side so the row fits inside the corner arc. */
+static int iFlatRoundInsetX(int y, int ymin, int ymax, int radius)
+{
+  double d = -1.0;
+  int yct = ymin + radius;
+  int ycb = ymax - radius;
+  if (radius <= 0)
+    return 0;
+  if (y < yct)
+    d = (double)(yct - y);
+  else if (y > ycb)
+    d = (double)(y - ycb);
+  if (d < 0.0)
+    return 0;
+  if (d > radius)
+    d = radius;
+  return (int)((double)radius - sqrt((double)radius * radius - d * d) + 0.5);
+}
+
+/* Vertical inset (in y) at scan column x. Mirror of iFlatRoundInsetX for top/bottom. */
+static int iFlatRoundInsetY(int x, int xmin, int xmax, int radius)
+{
+  double d = -1.0;
+  int xcl = xmin + radius;
+  int xcr = xmax - radius;
+  if (radius <= 0)
+    return 0;
+  if (x < xcl)
+    d = (double)(xcl - x);
+  else if (x > xcr)
+    d = (double)(x - xcr);
+  if (d < 0.0)
+    return 0;
+  if (d > radius)
+    d = radius;
+  return (int)((double)radius - sqrt((double)radius * radius - d * d) + 0.5);
+}
+
+static int iFlatClampRadius(int radius, int xmin, int xmax, int ymin, int ymax)
+{
+  int w = xmax - xmin;
+  int h = ymax - ymin;
+  int rmax = ((w < h) ? w : h) / 2;
+  if (radius < 0) radius = 0;
+  if (radius > rmax) radius = rmax;
+  return radius;
+}
+
+static long iFlatLerpColor(long c1, long c2, double t)
+{
+  unsigned char r = (unsigned char)(iupDrawRed(c1)   + (int)((iupDrawRed(c2)   - iupDrawRed(c1))   * t + 0.5));
+  unsigned char g = (unsigned char)(iupDrawGreen(c1) + (int)((iupDrawGreen(c2) - iupDrawGreen(c1)) * t + 0.5));
+  unsigned char b = (unsigned char)(iupDrawBlue(c1)  + (int)((iupDrawBlue(c2)  - iupDrawBlue(c1))  * t + 0.5));
+  unsigned char a = (unsigned char)(iupDrawAlpha(c1) + (int)((iupDrawAlpha(c2) - iupDrawAlpha(c1)) * t + 0.5));
+  return iupDrawColor(r, g, b, a);
+}
+
+/* Filled rounded rectangle with an optional 2-color gradient.
+ * - color2 NULL/empty => solid color1.
+ * - radius <= 0        => square corners.
+ * - vertical != 0      => gradient runs top->bottom, else left->right.                 */
+IUP_SDK_API void iupFlatDrawGradientBox(IdrawCanvas* dc, int xmin, int xmax, int ymin, int ymax,
+                                        int radius, const char* color1, const char* color2,
+                                        int vertical, const char* bgcolor, int active)
+{
+  long c1, c2;
+  int has_gradient;
+
+  if (!color1 || xmin == xmax || ymin == ymax)
+    return;
+
+  iupDrawCheckSwapCoord(xmin, xmax);
+  iupDrawCheckSwapCoord(ymin, ymax);
+
+  radius = iFlatClampRadius(radius, xmin, xmax, ymin, ymax);
+
+  c1 = iupDrawStrToColor(color1, 0);
+  has_gradient = (color2 && color2[0] != 0);
+  c2 = has_gradient ? iupDrawStrToColor(color2, c1) : c1;
+  if (!active)
+  {
+    c1 = iFlatDrawColorMakeInactive(c1, bgcolor);
+    c2 = iFlatDrawColorMakeInactive(c2, bgcolor);
+  }
+
+  /* fast path: solid fill, square corners */
+  if (!has_gradient && radius == 0)
+  {
+    iupdrvDrawRectangle(dc, xmin, ymin, xmax, ymax, c1, IUP_DRAW_FILL, 1);
+    return;
+  }
+
+#ifdef _WIN32
+  /* Prefer the GDI+ anti-aliased renderer for smooth corners + seamless gradient. */
+  if (iupdrvDrawFlatRoundBox(dc, xmin, ymin, xmax, ymax, radius, c1, c2, has_gradient, vertical))
+    return;
+#endif
+
+  if (vertical)
+  {
+    int y;
+    int span = ymax - ymin;
+    for (y = ymin; y <= ymax; y++)
+    {
+      int inset = iFlatRoundInsetX(y, ymin, ymax, radius);
+      long color = has_gradient ? iFlatLerpColor(c1, c2, (double)(y - ymin) / (double)span) : c1;
+      int x1 = xmin + inset;
+      int x2 = xmax - inset;
+      if (x2 >= x1)
+        iupdrvDrawRectangle(dc, x1, y, x2, y, color, IUP_DRAW_FILL, 1);
+    }
+  }
+  else
+  {
+    int x;
+    int span = xmax - xmin;
+    for (x = xmin; x <= xmax; x++)
+    {
+      int inset = iFlatRoundInsetY(x, xmin, xmax, radius);
+      long color = has_gradient ? iFlatLerpColor(c1, c2, (double)(x - xmin) / (double)span) : c1;
+      int y1 = ymin + inset;
+      int y2 = ymax - inset;
+      if (y2 >= y1)
+        iupdrvDrawRectangle(dc, x, y1, x, y2, color, IUP_DRAW_FILL, 1);
+    }
+  }
+}
+
+/* Filled rounded rectangle, solid color. Convenience wrapper over the gradient box. */
+IUP_SDK_API void iupFlatDrawRoundBox(IdrawCanvas* dc, int xmin, int xmax, int ymin, int ymax,
+                                     int radius, const char* fgcolor, const char* bgcolor, int active)
+{
+  iupFlatDrawGradientBox(dc, xmin, xmax, ymin, ymax, radius, fgcolor, NULL, 1, bgcolor, active);
+}
+
+/* Rounded-rectangle border. Scans rows (left/right + corners) and columns (top/bottom +
+ * corners); the union is a complete outline that exactly matches iupFlatDrawRoundBox.   */
+IUP_SDK_API void iupFlatDrawRoundBorder(IdrawCanvas* dc, int xmin, int xmax, int ymin, int ymax,
+                                        int radius, int border_width, const char* fgcolor,
+                                        const char* bgcolor, int active)
+{
+  long color;
+  int bw, y, x;
+
+  if (!fgcolor || border_width == 0 || xmin == xmax || ymin == ymax)
+    return;
+
+  iupDrawCheckSwapCoord(xmin, xmax);
+  iupDrawCheckSwapCoord(ymin, ymax);
+
+  radius = iFlatClampRadius(radius, xmin, xmax, ymin, ymax);
+  if (radius == 0)
+  {
+    iupFlatDrawBorder(dc, xmin, xmax, ymin, ymax, border_width, fgcolor, bgcolor, active);
+    return;
+  }
+
+  color = iupDrawStrToColor(fgcolor, 0);
+  if (!active)
+    color = iFlatDrawColorMakeInactive(color, bgcolor);
+
+  bw = border_width;
+  if (bw < 1) bw = 1;
+
+#ifdef _WIN32
+  /* Prefer the GDI+ anti-aliased stroke so the rounded border matches the AA fill. */
+  if (iupdrvDrawFlatRoundBorder(dc, xmin, ymin, xmax, ymax, radius, bw, color))
+    return;
+#endif
+
+  /* left + right sides and the left/right halves of the corner arcs */
+  for (y = ymin; y <= ymax; y++)
+  {
+    int inset = iFlatRoundInsetX(y, ymin, ymax, radius);
+    int lx = xmin + inset;
+    int rx = xmax - inset;
+    iupdrvDrawRectangle(dc, lx, y, lx + bw - 1, y, color, IUP_DRAW_FILL, 1);
+    iupdrvDrawRectangle(dc, rx - bw + 1, y, rx, y, color, IUP_DRAW_FILL, 1);
+  }
+
+  /* top + bottom sides and the top/bottom halves of the corner arcs */
+  for (x = xmin; x <= xmax; x++)
+  {
+    int inset = iFlatRoundInsetY(x, xmin, xmax, radius);
+    int ty = ymin + inset;
+    int by = ymax - inset;
+    iupdrvDrawRectangle(dc, x, ty, x, ty + bw - 1, color, IUP_DRAW_FILL, 1);
+    iupdrvDrawRectangle(dc, x, by - bw + 1, x, by, color, IUP_DRAW_FILL, 1);
+  }
+}
+
+/* Attribute-aware background fill for flat controls: honors CORNERRADIUS, GRADIENTCOLOR
+ * and GRADIENTDIRECTION on ih, falling back to the plain box when neither is set. */
+IUP_SDK_API void iupFlatDrawBoxAttrib(Ihandle* ih, IdrawCanvas* dc, int xmin, int xmax, int ymin, int ymax,
+                                      const char* fillcolor, const char* bgcolor, int active)
+{
+  int radius = ih ? iupAttribGetInt(ih, "CORNERRADIUS") : 0;
+  char* grad = ih ? iupAttribGetStr(ih, "GRADIENTCOLOR") : NULL;
+  int vertical = 1;
+  char* dir = ih ? iupAttribGetStr(ih, "GRADIENTDIRECTION") : NULL;
+  if (dir && iupStrEqualNoCase(dir, "HORIZONTAL"))
+    vertical = 0;
+  if (radius > 0 || (grad && grad[0] != 0))
+    iupFlatDrawGradientBox(dc, xmin, xmax, ymin, ymax, radius, fillcolor, grad, vertical, bgcolor, active);
+  else
+    iupFlatDrawBox(dc, xmin, xmax, ymin, ymax, fillcolor, bgcolor, active);
+}
+
+/* Attribute-aware border for flat controls: honors CORNERRADIUS on ih. */
+IUP_SDK_API void iupFlatDrawBorderAttrib(Ihandle* ih, IdrawCanvas* dc, int xmin, int xmax, int ymin, int ymax,
+                                         int border_width, const char* color, const char* bgcolor, int active)
+{
+  int radius = ih ? iupAttribGetInt(ih, "CORNERRADIUS") : 0;
+  if (radius > 0)
+    iupFlatDrawRoundBorder(dc, xmin, xmax, ymin, ymax, radius, border_width, color, bgcolor, active);
+  else
+    iupFlatDrawBorder(dc, xmin, xmax, ymin, ymax, border_width, color, bgcolor, active);
+}
+
