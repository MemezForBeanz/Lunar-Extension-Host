+/* Lunar fork: expose the topmost visible line so a themed flat scrollbar (IupFlatScrollBox
+   with NATIVETEXTSCROLL=YES) can mirror and drive the native EDIT's own virtualized scroll
+   without any native Win32 scrollbar. 1-based to match IUP line numbering. */
+static char* winTextGetFirstVisibleLineAttrib(Ihandle* ih)
+{
+  if (ih->data->is_multiline && ih->handle)
+  {
+    int line = (int)SendMessage(ih->handle, EM_GETFIRSTVISIBLELINE, 0, 0L);
+    return iupStrReturnInt(line + 1);
+  }
+  else
+    return "1";
+}
+
+static int winTextSetFirstVisibleLineAttrib(Ihandle* ih, const char* value)
+{
+  int line;
+  if (ih->data->is_multiline && ih->handle && iupStrToInt(value, &line))
+  {
+    int old_line = (int)SendMessage(ih->handle, EM_GETFIRSTVISIBLELINE, 0, 0L);
+    if (line < 1) line = 1;
+    SendMessage(ih->handle, EM_LINESCROLL, 0, (LPARAM)((line - 1) - old_line));
+  }
+  return 0;
+}
