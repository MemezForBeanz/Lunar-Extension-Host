+/* Lunar fork: the drop dialog is a top-level dialog, so IupClose's
+   iupDlgListDestroyAll can free it BEFORE the dropbutton that owns it. Upstream
+   then had the owner's destroy method test the dangling pointer with
+   iupObjectCheck, which reads freed memory and, when that memory still looks like
+   a handle, destroys it a second time (heap corruption on every app exit).
+   Instead, the dialog clears its owner's pointer as it is destroyed. */
+static int iDropButtonDialogDestroyCB(Ihandle* dlg)
+{
+  Ihandle* ih = (Ihandle*)iupAttribGet(dlg, "_IUP_DROPBUTTON_OWNER");
+  if (ih && ih->data && ih->data->dropdialog == dlg)
+    ih->data->dropdialog = NULL;
+  return IUP_DEFAULT;
+}
