+  iupClassRegisterAttribute(ic,"BGCOLOR",NULL,seg_post,IUP_FLAT_BACKCOLOR,NULL,IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic,"FGCOLOR",NULL,seg_post,IUP_FLAT_FORECOLOR,NULL,IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic,"PSCOLOR",NULL,seg_post,NULL,NULL,IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic,"TEXTPSCOLOR",NULL,seg_post,NULL,NULL,IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic,"BORDERCOLOR",NULL,seg_post,IUP_FLAT_BORDERCOLOR,NULL,IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic,"CORNERRADIUS",NULL,seg_post,"7",NULL,IUPAF_DEFAULT);
