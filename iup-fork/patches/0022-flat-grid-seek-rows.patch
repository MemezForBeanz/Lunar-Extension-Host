+typedef BOOL (WINAPI *WinDrawAlphaBlend)(HDC, int, int, int, int, HDC, int, int, int, int, BLENDFUNCTION);
+
+/* Lunar fork: AlphaBlend reads from a DC, so blended pixels pass through this small DIB. */
+typedef struct _IwinDrawBlend
+{
+  HDC hDC;
+  HBITMAP hBitmap, hOldBitmap;
+  unsigned char* bits;
+  int w, h;
+  WinDrawAlphaBlend alpha_blend;
+} IwinDrawBlend;
+
+static IwinDrawBlend win_draw_blend = { NULL, NULL, NULL, NULL, 0, 0, NULL };
+
+static void winDrawBlendFree(void)
+{
+  IwinDrawBlend* blend = &win_draw_blend;
+  if (blend->hBitmap)
+  {
+    SelectObject(blend->hDC, blend->hOldBitmap);
+    DeleteObject(blend->hBitmap);
+  }
+  if (blend->hDC)
+    DeleteDC(blend->hDC);
+  memset(blend, 0, sizeof(IwinDrawBlend));
+}
+
+static int winDrawBlendFits(int w, int h)
+{
+  IwinDrawBlend* blend = &win_draw_blend;
+  if (!blend->alpha_blend)
+  {
+    HMODULE lib = LoadLibrary(TEXT("Msimg32.dll"));
+    if (lib) blend->alpha_blend = (WinDrawAlphaBlend)GetProcAddress(lib, "AlphaBlend");
+    if (!blend->alpha_blend) return 0;
+  }
+  if (!blend->hDC) blend->hDC = CreateCompatibleDC(NULL);
+  if (!blend->hDC) return 0;
+  if (w > blend->w || h > blend->h)
+  {
+    BITMAPINFO bmi;
+    void* bits = NULL;
+    HBITMAP hBitmap;
+    int new_w = (iupMAX(w, blend->w) + 31) & ~31, new_h = (iupMAX(h, blend->h) + 31) & ~31;
+    memset(&bmi, 0, sizeof(bmi));
+    bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+    bmi.bmiHeader.biWidth = new_w;
+    bmi.bmiHeader.biHeight = -new_h;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    hBitmap = CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, &bits, NULL, 0);
+    if (!hBitmap) return 0;
+    if (blend->hBitmap)
+    {
+      SelectObject(blend->hDC, blend->hOldBitmap);
+      DeleteObject(blend->hBitmap);
+    }
+    blend->hBitmap = hBitmap;
+    blend->hOldBitmap = SelectObject(blend->hDC, hBitmap);
+    blend->bits = (unsigned char*)bits;
+    blend->w = new_w;
+    blend->h = new_h;
+  }
+  return 1;
+}
+
+IUP_SDK_API void iupdrvDrawBits(IdrawCanvas* dc, const unsigned char* bgra, int w, int h, int stride, int x, int y, int blend)
+{
+  if (dc->wdl_gc)
+  {
+    iupdrvDrawBitsWDL(dc->wdl_gc, bgra, w, h, stride, x, y);
+    return;
+  }
+  if (blend)
+  {
+    BLENDFUNCTION func = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    int row;
+    if (!winDrawBlendFits(w, h))
+      return;
+    GdiFlush();  /* the DIB is about to be written behind GDI's back */
+    for (row = 0; row < h; row++)
+      memcpy(win_draw_blend.bits + (size_t)row * win_draw_blend.w * 4, bgra + (size_t)row * stride, (size_t)w * 4);
+    win_draw_blend.alpha_blend(dc->hBitmapDC, x, y, w, h, win_draw_blend.hDC, 0, 0, w, h, func);
+  }
+  else
+  {
+    BITMAPINFO bmi;
+    memset(&bmi, 0, sizeof(bmi));
+    bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+    bmi.bmiHeader.biWidth = stride / 4;
+    bmi.bmiHeader.biHeight = -h;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    SetDIBitsToDevice(dc->hBitmapDC, x, y, (DWORD)w, (DWORD)h, 0, 0, 0, (UINT)h, bgra, &bmi, DIB_RGB_COLORS);
+  }
+}
