diff --git a/src/iup_flatseek.c b/src/iup_flatseek.c
new file mode 100644
index 0000000..ebad0c3
--- /dev/null
+++ b/src/iup_flatseek.c
@@ -0,0 +1,298 @@
+/* Lunar seek bar: a thin line with a tall hit area. A drag shows the new place at once and
+   commits on release, and a playback tick arriving during a drag does not move the line. */
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "iup.h"
+#include "iupcbs.h"
+#include "iupkey.h"
+#include "iup_object.h"
+#include "iup_attrib.h"
+#include "iup_str.h"
+#include "iup_drv.h"
+#include "iup_stdcontrols.h"
+#include "iup_register.h"
+#include "iup_drvfont.h"
+#include "iup_drvdraw.h"
+#include "iup_draw.h"
+
+#define SEEK_KNOB 6
+
+typedef int (*SeekValueCb)(Ihandle*, double);
+typedef int (*SeekHoverCb)(Ihandle*, double, int);
+typedef struct { double from, to; } SeekRange;
+
+struct _IcontrolData
+{
+  iupCanvas canvas;
+  double value, max;
+  SeekRange* buffered; int nbuffered;
+  SeekRange* marks; int nmarks;       /* a point mark has from == to */
+  int hover_x, dragging, focused;
+};
+
+/* "10-20,35,90-95": a list of ranges and points, in the same unit as VALUE. Text after a
+   colon names the mark for the caller; the bar draws a range or a point the same either way. */
+static int seek_parse(const char* value, SeekRange** out)
+{
+  int count = 0, cap = 8;
+  const char* p = value;
+  SeekRange* list;
+  free(*out);
+  *out = NULL;
+  if (!value || !*value) return 0;
+  list = (SeekRange*)malloc(sizeof(SeekRange) * cap);
+  while (list && *p)
+  {
+    char* end;
+    double from = strtod(p, &end), to = from;
+    if (end == p) break;
+    p = end;
+    if (*p == '-') { to = strtod(p + 1, &end); if (end != p + 1) p = end; }
+    while (*p && *p != ',' && *p != ';') p++;
+    if (*p) p++;
+    if (count == cap)
+    {
+      SeekRange* grown = (SeekRange*)realloc(list, sizeof(SeekRange) * cap * 2);
+      if (!grown) break;
+      list = grown; cap *= 2;
+    }
+    list[count].from = from; list[count].to = to; count++;
+  }
+  *out = list;
+  return list ? count : 0;
+}
+
+static void seek_track(Ihandle* ih, int* left, int* right)
+{
+  *left = SEEK_KNOB + 1;
+  *right = ih->currentwidth - SEEK_KNOB - 2;
+  if (*right <= *left) *right = *left + 1;
+}
+static int seek_x(Ihandle* ih, double value)
+{
+  int left, right;
+  double max = ih->data->max;
+  seek_track(ih, &left, &right);
+  if (max <= 0) return left;
+  if (value < 0) value = 0;
+  if (value > max) value = max;
+  return left + (int)((right - left) * (value / max) + 0.5);
+}
+static double seek_value_at(Ihandle* ih, int x)
+{
+  int left, right;
+  seek_track(ih, &left, &right);
+  if (x < left) x = left;
+  if (x > right) x = right;
+  return ih->data->max * (double)(x - left) / (double)(right - left);
+}
+
+static int seek_redraw(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  IdrawCanvas* dc = iupdrvDrawCreateCanvas(ih);
+  int w, h, i, left, right, active = iupdrvIsActive(ih), lively = d->hover_x >= 0 || d->dragging;
+  int thick = iupAttribGetInt(ih, "THICKNESS") + (lively ? 2 : 0), top, bottom, x;
+  char* bgname = IupGetAttribute(ih, "BGCOLOR");
+  char* played = IupGetAttribute(ih, "PSCOLOR");
+  char* markname = IupGetAttribute(ih, "MARKCOLOR");
+  long bg = iupDrawStrToColor(bgname, iupDrawColor(255, 255, 255, 255));
+  long track = iupDrawStrToColor(IupGetAttribute(ih, "TRACKCOLOR"), bg);
+  long buffered = iupDrawStrToColor(IupGetAttribute(ih, "BUFFERCOLOR"), track);
+  long fill = iupDrawStrToColor(played, track);
+  long mark = iupDrawStrToColor(markname, fill);
+  iupdrvDrawGetSize(dc, &w, &h);
+  iupdrvDrawRectangle(dc, 0, 0, w - 1, h - 1, bg, IUP_DRAW_FILL, 1);
+  seek_track(ih, &left, &right);
+  top = (h - thick) / 2;
+  bottom = top + thick - 1;
+  iupdrvDrawRectangle(dc, left, top, right, bottom, track, IUP_DRAW_FILL, 1);
+  for (i = 0; i < d->nbuffered; i++)
+    iupdrvDrawRectangle(dc, seek_x(ih, d->buffered[i].from), top, seek_x(ih, d->buffered[i].to), bottom, buffered, IUP_DRAW_FILL, 1);
+  for (i = 0; i < d->nmarks; i++)
+    if (d->marks[i].to > d->marks[i].from)
+      iupdrvDrawRectangle(dc, seek_x(ih, d->marks[i].from), top, seek_x(ih, d->marks[i].to), bottom, mark, IUP_DRAW_FILL, 1);
+  x = seek_x(ih, d->value);
+  if (d->max > 0) iupdrvDrawRectangle(dc, left, top, x, bottom, fill, IUP_DRAW_FILL, 1);
+  for (i = 0; i < d->nmarks; i++)
+    if (d->marks[i].to <= d->marks[i].from)
+    {
+      int tick = seek_x(ih, d->marks[i].from);
+      iupdrvDrawRectangle(dc, tick, top - 2, tick + 1, bottom + 2, mark, IUP_DRAW_FILL, 1);
+    }
+  if (d->hover_x >= 0 && !d->dragging)
+    iupdrvDrawRectangle(dc, d->hover_x, top - 3, d->hover_x, bottom + 3, fill, IUP_DRAW_FILL, 1);
+  if (d->max > 0 && active && (lively || d->focused))
+    iupFlatDrawDrawCircle(dc, x, h / 2, SEEK_KNOB, 1, 1, played, bgname, 1);
+  if (d->focused && IupGetInt(ih, "FOCUSFEEDBACK"))
+    iupFlatDrawDrawCircle(dc, x, h / 2, SEEK_KNOB + 2 < h / 2 ? SEEK_KNOB + 2 : SEEK_KNOB, 0, 1, played, bgname, 1);
+  iupdrvDrawFlush(dc); iupdrvDrawKillCanvas(dc);
+  return IUP_DEFAULT;
+}
+
+static void seek_changing(Ihandle* ih)
+{
+  SeekValueCb cb = (SeekValueCb)IupGetCallback(ih, "VALUECHANGING_CB");
+  if (cb) cb(ih, ih->data->value);
+}
+static void seek_commit(Ihandle* ih)
+{
+  SeekValueCb cb = (SeekValueCb)IupGetCallback(ih, "SEEK_CB");
+  if (cb) cb(ih, ih->data->value);
+}
+static int seek_button(Ihandle* ih, int button, int pressed, int x, int y, char* status)
+{
+  struct _IcontrolData* d = ih->data;
+  (void)y; (void)status;
+  if (button != IUP_BUTTON1 || d->max <= 0) return IUP_DEFAULT;
+  if (pressed)
+  {
+    if (iupAttribGetBoolean(ih, "CANFOCUS")) IupSetFocus(ih);
+    d->dragging = 1;
+    d->value = seek_value_at(ih, x);
+    seek_changing(ih);
+  }
+  else if (d->dragging)
+  {
+    d->dragging = 0;
+    seek_commit(ih);
+  }
+  iupdrvRedrawNow(ih);
+  return IUP_DEFAULT;
+}
+static int seek_motion(Ihandle* ih, int x, int y, char* status)
+{
+  struct _IcontrolData* d = ih->data;
+  SeekHoverCb cb = (SeekHoverCb)IupGetCallback(ih, "HOVER_CB");
+  (void)y; (void)status;
+  if (x == d->hover_x) return IUP_DEFAULT;
+  d->hover_x = x;
+  if (d->max > 0 && cb) cb(ih, seek_value_at(ih, x), x);
+  if (d->dragging)
+  {
+    d->value = seek_value_at(ih, x);
+    seek_changing(ih);
+  }
+  iupdrvRedrawNow(ih);
+  return IUP_DEFAULT;
+}
+static int seek_leave(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  SeekHoverCb cb = (SeekHoverCb)IupGetCallback(ih, "HOVER_CB");
+  d->hover_x = -1;
+  if (cb) cb(ih, 0, -1);
+  iupdrvRedrawNow(ih);
+  return IUP_DEFAULT;
+}
+static int seek_step(Ihandle* ih, double by)
+{
+  struct _IcontrolData* d = ih->data;
+  d->value += by;
+  if (d->value < 0) d->value = 0;
+  if (d->value > d->max) d->value = d->max;
+  seek_commit(ih);
+  iupdrvRedrawNow(ih);
+  return IUP_IGNORE;
+}
+static int seek_key(Ihandle* ih, int c)
+{
+  struct _IcontrolData* d = ih->data;
+  int base = iup_XkeyBase(c), ctrl = iup_isCtrlXkey(c);
+  double step = iupAttribGetDouble(ih, "STEP"), page = iupAttribGetDouble(ih, "PAGESTEP");
+  if (d->max <= 0) return IUP_CONTINUE;
+  switch (base)
+  {
+  case K_LEFT: case K_DOWN: return seek_step(ih, ctrl ? -page : -step);
+  case K_RIGHT: case K_UP: return seek_step(ih, ctrl ? page : step);
+  case K_PGDN: return seek_step(ih, -page);
+  case K_PGUP: return seek_step(ih, page);
+  case K_HOME: return seek_step(ih, -d->value);
+  case K_END: return seek_step(ih, d->max - d->value);
+  }
+  return IUP_CONTINUE;
+}
+static int seek_focus(Ihandle* ih, int focus) { ih->data->focused = focus; iupdrvRedrawNow(ih); return IUP_DEFAULT; }
+
+static int seek_set_value(Ihandle* ih, const char* value)
+{
+  struct _IcontrolData* d = ih->data;
+  double v = 0;
+  if (d->dragging) return 0;
+  iupStrToDouble(value, &v);
+  d->value = v < 0 ? 0 : v > d->max ? d->max : v;
+  if (ih->handle) iupdrvPostRedraw(ih);
+  return 0;
+}
+static char* seek_get_value(Ihandle* ih) { return iupStrReturnDouble(ih->data->value); }
+static int seek_set_max(Ihandle* ih, const char* value)
+{
+  struct _IcontrolData* d = ih->data;
+  double v = 0;
+  iupStrToDouble(value, &v);
+  d->max = v > 0 ? v : 0;
+  if (d->value > d->max) d->value = d->max;
+  if (ih->handle) iupdrvPostRedraw(ih);
+  return 0;
+}
+static char* seek_get_max(Ihandle* ih) { return iupStrReturnDouble(ih->data->max); }
+static int seek_set_buffered(Ihandle* ih, const char* value)
+{
+  ih->data->nbuffered = seek_parse(value, &ih->data->buffered);
+  if (ih->handle) iupdrvPostRedraw(ih);
+  return 1;
+}
+static int seek_set_marks(Ihandle* ih, const char* value)
+{
+  ih->data->nmarks = seek_parse(value, &ih->data->marks);
+  if (ih->handle) iupdrvPostRedraw(ih);
+  return 1;
+}
+static char* seek_get_accessible(Ihandle* ih)
+{
+  return iupStrReturnStrf("%d of %d", (int)ih->data->value, (int)ih->data->max);
+}
+static int seek_post(Ihandle* ih, const char* value) { (void)value; if (ih->handle) iupdrvPostRedraw(ih); return 1; }
+static void seek_size(Ihandle* ih, int* w, int* h, int* expand) { *w = 240; *h = 24; (void)ih; (void)expand; }
+static void seek_destroy(Ihandle* ih) { free(ih->data->buffered); free(ih->data->marks); }
+static int seek_create(Ihandle* ih, void** params)
+{
+  free(ih->data); ih->data = iupALLOCCTRLDATA(); (void)params;
+  ih->data->hover_x = -1;
+  IupSetAttribute(ih, "EXPAND", "HORIZONTAL");
+  IupSetCallback(ih, "ACTION", (Icallback)seek_redraw);
+  IupSetCallback(ih, "BUTTON_CB", (Icallback)seek_button);
+  IupSetCallback(ih, "MOTION_CB", (Icallback)seek_motion);
+  IupSetCallback(ih, "LEAVEWINDOW_CB", (Icallback)seek_leave);
+  IupSetCallback(ih, "FOCUS_CB", (Icallback)seek_focus);
+  IupSetCallback(ih, "K_ANY", (Icallback)seek_key);
+  return IUP_NOERROR;
+}
+IUP_API Ihandle* IupFlatSeek(void) { return IupCreate("flatseek"); }
+Iclass* iupFlatSeekNewClass(void)
+{
+  Iclass* ic = iupClassNew(iupRegisterFindClass("canvas"));
+  ic->name = "flatseek"; ic->cons = "FlatSeek"; ic->nativetype = IUP_TYPECANVAS;
+  ic->childtype = IUP_CHILDNONE; ic->is_interactive = 1;
+  ic->New = iupFlatSeekNewClass; ic->Create = seek_create; ic->Destroy = seek_destroy; ic->ComputeNaturalSize = seek_size;
+  iupClassRegisterReplaceAttribDef(ic, "BORDER", "NO", NULL);
+  iupClassRegisterCallback(ic, "SEEK_CB", "d");
+  iupClassRegisterCallback(ic, "VALUECHANGING_CB", "d");
+  iupClassRegisterCallback(ic, "HOVER_CB", "di");
+  iupClassRegisterAttribute(ic, "VALUE", seek_get_value, seek_set_value, "0", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "MAX", seek_get_max, seek_set_max, "0", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "BUFFERED", NULL, seek_set_buffered, NULL, NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "MARKS", NULL, seek_set_marks, NULL, NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "STEP", NULL, NULL, "5", NULL, IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "PAGESTEP", NULL, NULL, "30", NULL, IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "THICKNESS", NULL, seek_post, "2", NULL, IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "ACCESSIBLEVALUE", seek_get_accessible, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "BGCOLOR", NULL, seek_post, IUP_FLAT_BACKCOLOR, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "TRACKCOLOR", NULL, seek_post, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "BUFFERCOLOR", NULL, seek_post, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "PSCOLOR", NULL, seek_post, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "MARKCOLOR", NULL, seek_post, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "FOCUSFEEDBACK", NULL, NULL, "YES", NULL, IUPAF_NO_INHERIT);
+  return ic;
+}
