diff --git a/src/iup_flatgrid.c b/src/iup_flatgrid.c
new file mode 100644
index 0000000..06a9780
--- /dev/null
+++ b/src/iup_flatgrid.c
@@ -0,0 +1,792 @@
+/* Lunar virtual cell grid: only the cells in view are queried and painted.
+   Cells sit on lanes across the scroll direction and lines along it, so a vertical grid and a
+   horizontal shelf are the same arithmetic. The pixels of an image stay with the provider. */
+#ifdef WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#endif
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+#include <math.h>
+#include "iup.h"
+#include "iupcbs.h"
+#include "iupkey.h"
+#include "iup_object.h"
+#include "iup_attrib.h"
+#include "iup_str.h"
+#include "iup_drv.h"
+#include "iup_stdcontrols.h"
+#include "iup_register.h"
+#include "iup_drvfont.h"
+#include "iup_drvdraw.h"
+#include "iup_draw.h"
+#include "iup_flatscrollbar.h"
+
+#define GRID_RING 6            /* room around a cell for its selection and focus rings */
+#define GRID_TYPEAHEAD_MS 900
+#define GRID_TYPEAHEAD_MAX 63
+
+enum { GRID_PLAIN, GRID_EXTEND, GRID_TOGGLE };
+
+typedef char* (*GridValueCb)(Ihandle*, int, const char*);
+typedef void* (*GridBitsCb)(Ihandle*, int, int, int, int*);
+typedef int (*GridCellCb)(Ihandle*, int, const char*);
+typedef int (*GridActionCb)(Ihandle*, int);
+typedef int (*GridTypeAheadCb)(Ihandle*, const char*);
+
+struct _IcontrolData
+{
+  iupCanvas canvas;
+  int count, cursor, anchor, hover, focused;
+  int horizontal, padding, gutter;
+  int cellw, cellh, imageh, charh;
+  int lanes, pitch, available;
+  unsigned char* marks;        /* one bit per cell, MULTIPLE only */
+  int marked;
+  unsigned char* corners;      /* four premultiplied tiles, each radius x radius */
+  int corners_radius;
+  long corners_color;
+  char typed[GRID_TYPEAHEAD_MAX + 1];
+  unsigned long typed_at;
+};
+
+typedef struct
+{
+  long bg, fg, secondary, placeholder, marker;
+  char* bgname; char* fgname; char* markername; char* hoverbg; char* font;
+  int radius, focusring, showtext;
+  GridBitsCb bits;
+} GridPaint;
+
+static unsigned long grid_ticks(void)
+{
+#ifdef WIN32
+  return (unsigned long)GetTickCount();
+#else
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (unsigned long)now.tv_sec * 1000UL + (unsigned long)(now.tv_nsec / 1000000L);
+#endif
+}
+
+static int grid_max(int a, int b) { return a > b ? a : b; }
+static int grid_min(int a, int b) { return a < b ? a : b; }
+
+static char* grid_value(Ihandle* ih, const char* field, int pos)
+{
+  GridValueCb cb = (GridValueCb)IupGetCallback(ih, "CELLVALUE_CB");
+  return cb ? cb(ih, pos, field) : NULL;
+}
+
+/* ---- geometry ------------------------------------------------------------------------- */
+
+static double grid_aspect(Ihandle* ih)
+{
+  char* value = iupAttribGetStr(ih, "ASPECT");
+  double a = 0, b = 0;
+  if (value)
+  {
+    if (sscanf(value, "%lf:%lf", &a, &b) == 2 && a > 0 && b > 0) return a / b;
+    if (sscanf(value, "%lf", &a) == 1 && a > 0) return a;
+  }
+  return 2.0 / 3.0;
+}
+
+static void grid_measure(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  int text, bar = iupAttribGetInt(ih, "SCROLLBARSIZE");
+  iupdrvFontGetCharSize(ih, NULL, &d->charh);
+  d->horizontal = iupStrEqualNoCase(iupAttribGetStr(ih, "ORIENTATION"), "HORIZONTAL");
+  d->padding = grid_max(iupAttribGetInt(ih, "PADDING"), GRID_RING);
+  d->gutter = grid_max(iupAttribGetInt(ih, "GUTTER"), 2 * GRID_RING);
+  d->cellw = grid_max(iupAttribGetInt(ih, "CELLWIDTH"), 32);
+  d->imageh = grid_max((int)(d->cellw / grid_aspect(ih) + 0.5), 16);
+  text = iupAttribGetBoolean(ih, "SHOWTEXT") ? 6 + 2 * (d->charh + 2) : 0;
+  d->cellh = d->imageh + text;
+  if (d->horizontal)
+  {
+    d->available = 0;
+    d->lanes = grid_max(iupAttribGetInt(ih, "ROWS"), 1);
+    d->pitch = d->cellw + d->gutter;
+  }
+  else
+  {
+    d->available = ih->currentwidth - 2 * d->padding - bar;
+    d->lanes = grid_max((d->available + d->gutter) / (d->cellw + d->gutter), 1);
+    d->pitch = d->cellh + d->gutter;
+  }
+}
+
+static int grid_lines(Ihandle* ih) { return (ih->data->count + ih->data->lanes - 1) / ih->data->lanes; }
+static int grid_total(Ihandle* ih)
+{
+  int lines = grid_lines(ih);
+  return lines ? 2 * ih->data->padding + lines * ih->data->pitch - ih->data->gutter : 0;
+}
+static int grid_extent(Ihandle* ih) { return ih->data->horizontal ? ih->currentwidth : ih->currentheight; }
+static int grid_scroll(Ihandle* ih) { return IupGetInt(ih, ih->data->horizontal ? "POSX" : "POSY"); }
+static void grid_set_scroll(Ihandle* ih, int value) { IupSetInt(ih, ih->data->horizontal ? "POSX" : "POSY", value); }
+
+/* The cell's corner on the canvas. Lanes spread to fill the width, so both edges of a vertical
+   grid sit on the padding; the spare pixels go in the gutters and the cell keeps its size,
+   which is what lets one decoded image serve every window width. */
+static void grid_cell_xy(Ihandle* ih, int pos, int* x, int* y)
+{
+  struct _IcontrolData* d = ih->data;
+  int lane = (pos - 1) % d->lanes, line = (pos - 1) / d->lanes;
+  int along = d->padding + line * d->pitch - grid_scroll(ih);
+  if (d->horizontal)
+  {
+    *x = along;
+    *y = d->padding + lane * (d->cellh + d->gutter);
+  }
+  else
+  {
+    *x = d->padding + (d->lanes > 1 ? lane * (d->available - d->cellw) / (d->lanes - 1) : 0);
+    *y = along;
+  }
+}
+
+static int grid_hit(Ihandle* ih, int x, int y)
+{
+  struct _IcontrolData* d = ih->data;
+  int across = d->horizontal ? y : x, along = (d->horizontal ? x : y) + grid_scroll(ih) - d->padding;
+  int span = d->horizontal ? d->cellw : d->cellh, line, lane;
+  if (along < 0 || !d->lanes) return 0;
+  line = along / d->pitch;
+  if (along % d->pitch >= span) return 0;
+  for (lane = 0; lane < d->lanes; lane++)
+  {
+    int start, size, pos = line * d->lanes + lane + 1, cx, cy;
+    if (pos > d->count) return 0;
+    grid_cell_xy(ih, pos, &cx, &cy);
+    start = d->horizontal ? cy : cx;
+    size = d->horizontal ? d->cellh : d->cellw;
+    if (across >= start && across < start + size) return pos;
+  }
+  return 0;
+}
+
+static int grid_first(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  return d->lanes && d->pitch ? grid_scroll(ih) / d->pitch * d->lanes + 1 : 1;
+}
+
+/* A resize keeps the first cell in view where it is, whatever the lanes become. */
+static void grid_refresh(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  int first = grid_first(ih), scrolled = grid_scroll(ih) > 0, total;
+  grid_measure(ih);
+  total = grid_total(ih);
+  if (d->horizontal)
+  {
+    IupSetInt(ih, "XMAX", total);
+    IupSetInt(ih, "DX", grid_max(ih->currentwidth, 1));
+    IupSetInt(ih, "YMAX", 0);
+    IupSetInt(ih, "DY", grid_max(ih->currentheight, 1));
+    IupSetInt(ih, "LINEX", d->pitch / 3);
+  }
+  else
+  {
+    IupSetInt(ih, "YMAX", total);
+    IupSetInt(ih, "DY", grid_max(ih->currentheight, 1));
+    IupSetInt(ih, "XMAX", 0);
+    IupSetInt(ih, "DX", grid_max(ih->currentwidth, 1));
+    IupSetInt(ih, "LINEY", d->pitch / 3);
+  }
+  if (scrolled) grid_set_scroll(ih, (first - 1) / d->lanes * d->pitch);
+  if (ih->handle) iupdrvPostRedraw(ih);
+}
+
+/* ---- painting ------------------------------------------------------------------------- */
+
+/* Rounds a rectangular image by painting the outside of each corner in the background colour,
+   with its antialiased edge. Premultiplied, because that is what the blit composites. */
+static void grid_build_corners(Ihandle* ih, int radius, long color)
+{
+  struct _IcontrolData* d = ih->data;
+  int x, y, sx, sy, i;
+  unsigned char b = iupDrawBlue(color), g = iupDrawGreen(color), r = iupDrawRed(color);
+  if (radius == d->corners_radius && color == d->corners_color && d->corners) return;
+  free(d->corners);
+  d->corners = (unsigned char*)malloc((size_t)radius * radius * 4 * 4);
+  d->corners_radius = radius;
+  d->corners_color = color;
+  if (!d->corners) { d->corners_radius = 0; return; }
+  for (y = 0; y < radius; y++)
+    for (x = 0; x < radius; x++)
+    {
+      int outside = 0;
+      unsigned char px[4];
+      for (sy = 0; sy < 4; sy++)
+        for (sx = 0; sx < 4; sx++)
+        {
+          double dx = radius - (x + (sx + 0.5) / 4.0), dy = radius - (y + (sy + 0.5) / 4.0);
+          if (dx * dx + dy * dy > (double)radius * radius) outside++;
+        }
+      px[0] = (unsigned char)(b * outside / 16);
+      px[1] = (unsigned char)(g * outside / 16);
+      px[2] = (unsigned char)(r * outside / 16);
+      px[3] = (unsigned char)(255 * outside / 16);
+      for (i = 0; i < 4; i++)
+      {
+        int tx = (i & 1) ? radius - 1 - x : x, ty = (i & 2) ? radius - 1 - y : y;
+        memcpy(d->corners + ((size_t)i * radius * radius + (size_t)ty * radius + tx) * 4, px, 4);
+      }
+    }
+}
+
+static void grid_draw_corners(Ihandle* ih, IdrawCanvas* dc, int x, int y, int w, int h, int radius)
+{
+  struct _IcontrolData* d = ih->data;
+  size_t tile = (size_t)radius * radius * 4;
+  if (radius < 1 || !d->corners) return;
+  iupdrvDrawBits(dc, d->corners, radius, radius, radius * 4, x, y, 1);
+  iupdrvDrawBits(dc, d->corners + tile, radius, radius, radius * 4, x + w - radius, y, 1);
+  iupdrvDrawBits(dc, d->corners + 2 * tile, radius, radius, radius * 4, x, y + h - radius, 1);
+  iupdrvDrawBits(dc, d->corners + 3 * tile, radius, radius, radius * 4, x + w - radius, y + h - radius, 1);
+}
+
+static int grid_is_marked(Ihandle* ih, int pos)
+{
+  struct _IcontrolData* d = ih->data;
+  if (d->marks) return (d->marks[(pos - 1) / 8] >> ((pos - 1) % 8)) & 1;
+  return pos == d->cursor;
+}
+
+static void grid_draw_cell(Ihandle* ih, IdrawCanvas* dc, int pos, int x, int y, GridPaint* p)
+{
+  struct _IcontrolData* d = ih->data;
+  int w = d->cellw, h = d->imageh, stride = 0;
+  void* bits = p->bits ? p->bits(ih, pos, w, h, &stride) : NULL;
+  char* title = grid_value(ih, "TITLE", pos);
+  char* badge = grid_value(ih, "BADGE", pos);
+  char* progress = grid_value(ih, "PROGRESS", pos);
+  char* state = grid_value(ih, "STATE", pos);
+  char* secondary;
+  int offline = state && iupStrEqualNoCase(state, "offline");
+
+  if (bits)
+    iupdrvDrawBits(dc, (const unsigned char*)bits, w, h, stride, x, y, 0);
+  else
+  {
+    iupdrvDrawRectangle(dc, x, y, x + w - 1, y + h - 1, p->placeholder, IUP_DRAW_FILL, 1);
+    if (title)  /* wrapped text ignores vertical centring, so the box is placed by hand */
+      iupdrvDrawText(dc, title, (int)strlen(title), x + 8, y + h / 2 - d->charh - 2, w - 16, h / 2, p->secondary, p->font,
+        IUP_DRAW_CENTER | IUP_DRAW_WRAP | IUP_DRAW_CLIP, 0);
+  }
+  if (progress && atoi(progress) > 0)
+  {
+    int value = grid_min(atoi(progress), 100), left = x + 4, right = x + w - 5, top = y + h - 6;
+    iupdrvDrawRectangle(dc, left, top, right, top + 2, p->bg, IUP_DRAW_FILL, 1);
+    iupdrvDrawRectangle(dc, left, top, left + (right - left) * value / 100, top + 2, p->marker, IUP_DRAW_FILL, 1);
+  }
+  if (badge && *badge)
+  {
+    int len = (int)strlen(badge), tw = iupdrvFontGetStringWidth(ih, badge) + 10, th = d->charh + 2;
+    int bx = x + w - tw - 6, by = y + 6;
+    iupdrvDrawRectangle(dc, bx, by, bx + tw - 1, by + th - 1, p->bg, IUP_DRAW_FILL, 1);
+    iupdrvDrawText(dc, badge, len, bx, by, tw, th, p->fg, p->font,
+      IUP_DRAW_CENTER | IUP_DRAW_LAYOUTCENTER | IUP_DRAW_CLIP, 0);
+  }
+  if (state && iupStrEqualNoCase(state, "unplayed"))
+    iupdrvDrawRectangle(dc, x + 6, y + 6, x + 11, y + 11, p->marker, IUP_DRAW_FILL, 1);
+  grid_draw_corners(ih, dc, x, y, w, h, p->radius);
+
+  if (grid_is_marked(ih, pos))
+    iupFlatDrawRoundBorder(dc, x - 2, x + w + 1, y - 2, y + h + 1, p->radius + 2, 2, p->markername, p->bgname, 1);
+  else if (pos == d->hover && p->hoverbg)
+    iupFlatDrawRoundBorder(dc, x - 1, x + w, y - 1, y + h, p->radius + 1, 1, p->hoverbg, p->bgname, 1);
+  if (d->focused && pos == d->cursor && p->focusring)
+    iupFlatDrawRoundBorder(dc, x - 4, x + w + 3, y - 4, y + h + 3, p->radius + 4, 1, p->fgname, p->bgname, 1);
+
+  if (p->showtext)
+  {
+    int line = d->charh + 2, ty = y + h + 6;
+    if (title)
+      iupdrvDrawText(dc, title, (int)strlen(title), x, ty, w, line, offline ? p->secondary : p->fg, p->font,
+        IUP_DRAW_LEFT | IUP_DRAW_ELLIPSIS, 0);
+    secondary = grid_value(ih, "SECONDARY", pos);
+    if (secondary)
+      iupdrvDrawText(dc, secondary, (int)strlen(secondary), x, ty + line, w, line, p->secondary, p->font,
+        IUP_DRAW_LEFT | IUP_DRAW_ELLIPSIS, 0);
+  }
+}
+
+static int grid_redraw(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  IdrawCanvas* dc = iupdrvDrawCreateCanvas(ih);
+  int w, h, cx = 0, cy = 0, cw, ch, scroll, extent, line, lastline, lane;
+  char* clip = iupAttribGet(ih, "CLIPRECT");
+  GridPaint p;
+  iupdrvDrawGetSize(dc, &w, &h);
+  cw = w; ch = h;
+  if (clip) sscanf(clip, "%d %d %d %d", &cx, &cy, &cw, &ch);
+
+  p.bgname = IupGetAttribute(ih, "BGCOLOR");
+  p.bg = iupDrawStrToColor(p.bgname, iupDrawColor(255, 255, 255, 255));
+  p.fgname = IupGetAttribute(ih, "FGCOLOR");
+  p.fg = iupDrawStrToColor(p.fgname, iupDrawColor(30, 30, 30, 255));
+  p.secondary = iupDrawStrToColor(IupGetAttribute(ih, "SECONDARYCOLOR"), p.fg);
+  p.placeholder = iupDrawStrToColor(IupGetAttribute(ih, "PLACEHOLDERCOLOR"), p.bg);
+  p.markername = IupGetAttribute(ih, "ITEMMARKERCOLOR");
+  if (!p.markername) p.markername = IupGetAttribute(ih, "FGCOLOR");
+  p.marker = iupDrawStrToColor(p.markername, p.fg);
+  p.hoverbg = IupGetAttribute(ih, "HLCOLOR");
+  p.font = IupGetAttribute(ih, "FONT");
+  p.radius = grid_max(iupAttribGetInt(ih, "ITEMRADIUS"), 0);
+  p.focusring = IupGetInt(ih, "FOCUSFEEDBACK");
+  p.showtext = iupAttribGetBoolean(ih, "SHOWTEXT");
+  p.bits = (GridBitsCb)IupGetCallback(ih, "CELLBITS_CB");
+  if (p.radius > 0) grid_build_corners(ih, p.radius, p.bg);
+
+  iupdrvDrawRectangle(dc, cx, cy, cx + cw - 1, cy + ch - 1, p.bg, IUP_DRAW_FILL, 1);
+  if (d->count == 0)
+  {
+    char* empty = IupGetAttribute(ih, "EMPTYTITLE");
+    char* hint = IupGetAttribute(ih, "EMPTYHINT");
+    if (empty) iupdrvDrawText(dc, empty, (int)strlen(empty), 16, h / 2 - 22, w - 32, 26, p.fg, p.font,
+      IUP_DRAW_CENTER | IUP_DRAW_LAYOUTCENTER | IUP_DRAW_ELLIPSIS, 0);
+    if (hint) iupdrvDrawText(dc, hint, (int)strlen(hint), 16, h / 2 + 5, w - 32, 22, p.secondary, p.font,
+      IUP_DRAW_CENTER | IUP_DRAW_LAYOUTCENTER | IUP_DRAW_ELLIPSIS, 0);
+  }
+  scroll = grid_scroll(ih);
+  extent = d->horizontal ? w : h;
+  line = grid_max(scroll - d->padding, 0) / d->pitch;
+  lastline = (scroll + extent) / d->pitch;
+  for (; line <= lastline; line++)
+    for (lane = 0; lane < d->lanes; lane++)
+    {
+      int pos = line * d->lanes + lane + 1, x, y;
+      if (pos > d->count) break;
+      grid_cell_xy(ih, pos, &x, &y);
+      if (x + d->cellw + GRID_RING <= cx || x - GRID_RING >= cx + cw ||
+          y + d->cellh + GRID_RING <= cy || y - GRID_RING >= cy + ch) continue;
+      grid_draw_cell(ih, dc, pos, x, y, &p);
+    }
+  iupdrvDrawFlush(dc); iupdrvDrawKillCanvas(dc);
+  return IUP_DEFAULT;
+}
+
+/* Repaints one cell and whatever rings it has. Everything else keeps its pixels. */
+static void grid_touch(Ihandle* ih, int pos)
+{
+  struct _IcontrolData* d = ih->data;
+  int x, y;
+  if (!ih->handle || pos < 1 || pos > d->count) return;
+  grid_cell_xy(ih, pos, &x, &y);
+  iupdrvPostRedrawRect(ih, x - GRID_RING, y - GRID_RING, d->cellw + 2 * GRID_RING, d->cellh + 2 * GRID_RING);
+}
+
+/* ---- selection ------------------------------------------------------------------------ */
+
+static void grid_mark_all(Ihandle* ih, int on)
+{
+  struct _IcontrolData* d = ih->data;
+  if (!d->marks) return;
+  memset(d->marks, on ? 0xFF : 0, (size_t)(d->count + 7) / 8);
+  d->marked = on ? d->count : 0;
+}
+static void grid_mark(Ihandle* ih, int pos, int on)
+{
+  struct _IcontrolData* d = ih->data;
+  unsigned char bit = (unsigned char)(1 << ((pos - 1) % 8));
+  unsigned char* byte = d->marks + (pos - 1) / 8;
+  if (!!(*byte & bit) == !!on) return;
+  if (on) { *byte |= bit; d->marked++; }
+  else { *byte &= (unsigned char)~bit; d->marked--; }
+}
+static void grid_alloc_marks(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  free(d->marks);
+  d->marks = NULL;
+  d->marked = 0;
+  if (iupAttribGetBoolean(ih, "MULTIPLE"))
+    d->marks = (unsigned char*)calloc((size_t)(d->count + 7) / 8 + 1, 1);
+}
+
+/* Brings a cell into view. Returns whether anything moved. */
+static int grid_reveal(Ihandle* ih, int pos)
+{
+  struct _IcontrolData* d = ih->data;
+  int scroll = grid_scroll(ih), extent = grid_extent(ih), span = d->horizontal ? d->cellw : d->cellh;
+  int along = d->padding + (pos - 1) / d->lanes * d->pitch, next = scroll;
+  if (along - GRID_RING < scroll) next = grid_max(along - GRID_RING, 0);
+  else if (along + span + GRID_RING > scroll + extent) next = along + span + GRID_RING - extent;
+  if (next == scroll) return 0;
+  grid_set_scroll(ih, next);
+  return 1;
+}
+
+static int grid_go(Ihandle* ih, int pos, int mode)
+{
+  struct _IcontrolData* d = ih->data;
+  int before = d->cursor, repaint = 0, changed;
+  if (!d->count) return IUP_IGNORE;
+  pos = grid_max(grid_min(pos, d->count), 1);
+  changed = pos != before;
+  if (d->marks)
+  {
+    if (mode == GRID_TOGGLE)
+    {
+      grid_mark(ih, pos, !grid_is_marked(ih, pos));
+      changed = 1;
+    }
+    else
+    {
+      int i, from, to;
+      changed = changed || d->marked != 1 || !grid_is_marked(ih, pos);
+      if (d->marked) { grid_mark_all(ih, 0); repaint = 1; }
+      from = grid_min(mode == GRID_EXTEND && d->anchor ? d->anchor : pos, pos);
+      to = grid_max(mode == GRID_EXTEND && d->anchor ? d->anchor : pos, pos);
+      for (i = from; i <= to; i++) grid_mark(ih, i, 1);
+    }
+  }
+  d->cursor = pos;
+  if (mode != GRID_EXTEND) d->anchor = pos;
+  if (grid_reveal(ih, pos)) repaint = 1;
+  if (repaint) { if (ih->handle) iupdrvPostRedraw(ih); }
+  else { grid_touch(ih, before); grid_touch(ih, pos); }
+  if (changed)
+  {
+    GridActionCb action = (GridActionCb)IupGetCallback(ih, "CELL_ACTION_CB");
+    IFn notify = (IFn)IupGetCallback(ih, "VALUECHANGED_CB");
+    if (action) action(ih, pos);
+    if (notify) notify(ih);
+  }
+  return IUP_IGNORE;
+}
+
+static int grid_activate(Ihandle* ih, int pos, const char* how)
+{
+  GridCellCb cb = (GridCellCb)IupGetCallback(ih, "CELL_ACTIVATE_CB");
+  if (cb && pos) cb(ih, pos, how);
+  return IUP_IGNORE;
+}
+
+/* ---- input ---------------------------------------------------------------------------- */
+
+static int grid_title_matches(const char* title, const char* typed)
+{
+  for (; *typed; title++, typed++)
+    if (tolower((unsigned char)*title) != tolower((unsigned char)*typed)) return 0;
+  return 1;
+}
+
+static int grid_type_ahead(Ihandle* ih, int c)
+{
+  struct _IcontrolData* d = ih->data;
+  size_t len;
+  int step, start, pos;
+  GridTypeAheadCb cb = (GridTypeAheadCb)IupGetCallback(ih, "TYPEAHEAD_CB");
+  d->typed_at = grid_ticks();
+  len = strlen(d->typed);
+  if (len < GRID_TYPEAHEAD_MAX) { d->typed[len++] = (char)c; d->typed[len] = 0; }
+  if (cb)
+  {
+    pos = cb(ih, d->typed);
+    if (pos >= 0) { if (pos > 0) grid_go(ih, pos, GRID_PLAIN); return IUP_IGNORE; }
+  }
+  start = d->cursor ? d->cursor : 1;
+  if (len == 1) start = start % d->count + 1;  /* the same letter again moves on */
+  for (step = 0, pos = start; step < d->count; step++, pos = pos % d->count + 1)
+  {
+    char* title = grid_value(ih, "TITLE", pos);
+    if (title && grid_title_matches(title, d->typed)) { grid_go(ih, pos, GRID_PLAIN); break; }
+  }
+  return IUP_IGNORE;
+}
+
+static int grid_key(Ihandle* ih, int c)
+{
+  struct _IcontrolData* d = ih->data;
+  int base = iup_XkeyBase(c), ctrl = iup_isCtrlXkey(c), shift = iup_isShiftXkey(c);
+  int mode = shift ? GRID_EXTEND : GRID_PLAIN;
+  int across = d->horizontal ? d->lanes : 1, down = d->horizontal ? 1 : d->lanes;
+  int page = grid_max(grid_extent(ih) / d->pitch, 1) * d->lanes, target;
+  if (!d->count) return IUP_CONTINUE;
+  switch (base)
+  {
+  case K_LEFT: target = d->cursor - across; break;
+  case K_RIGHT: target = d->cursor + across; break;
+  case K_UP: target = d->cursor - down; break;
+  case K_DOWN: target = d->cursor + down; break;
+  case K_PGUP: return grid_go(ih, d->cursor - page, mode);
+  case K_PGDN: return grid_go(ih, d->cursor + page, mode);
+  case K_HOME: return grid_go(ih, 1, mode);
+  case K_END: return grid_go(ih, d->count, mode);
+  case K_CR: return grid_activate(ih, d->cursor, "enter");
+  default:
+    if (ctrl && (base == 'a' || base == 'A') && d->marks)
+    {
+      grid_mark_all(ih, 1);
+      if (ih->handle) iupdrvPostRedraw(ih);
+      if (IupGetCallback(ih, "VALUECHANGED_CB")) ((IFn)IupGetCallback(ih, "VALUECHANGED_CB"))(ih);
+      return IUP_IGNORE;
+    }
+    if (ctrl || iup_isAltXkey(c) || iup_isSysXkey(c) || !iup_isprint(base)) return IUP_CONTINUE;
+    if (grid_ticks() - d->typed_at > GRID_TYPEAHEAD_MS) d->typed[0] = 0;
+    if (base == K_SP && !d->typed[0])  /* a title has spaces, so only a word in progress takes one */
+    {
+      if (d->marks && d->cursor) return grid_go(ih, d->cursor, GRID_TOGGLE);
+      return IUP_CONTINUE;
+    }
+    return grid_type_ahead(ih, base);
+  }
+  /* Past the last line, the last cell, once. Sideways off either end stays put. */
+  if (!d->cursor) return grid_go(ih, 1, mode);
+  if (target > d->count)
+    target = (d->cursor - 1) / d->lanes < (d->count - 1) / d->lanes ? d->count : d->cursor;
+  if (target < 1) target = d->cursor;
+  return grid_go(ih, target, mode);
+}
+
+static int grid_button(Ihandle* ih, int button, int pressed, int x, int y, char* status)
+{
+  struct _IcontrolData* d = ih->data;
+  int pos;
+  if (!pressed) return IUP_DEFAULT;
+  if (iupAttribGetBoolean(ih, "CANFOCUS")) IupSetFocus(ih);
+  pos = grid_hit(ih, x, y);
+  if (!pos) return IUP_DEFAULT;
+  if (button == IUP_BUTTON3)
+  {
+    GridCellCb cb = (GridCellCb)IupGetCallback(ih, "CELL_CONTEXT_CB");
+    if (!grid_is_marked(ih, pos)) grid_go(ih, pos, GRID_PLAIN);
+    if (cb) cb(ih, pos, "context");
+    return IUP_DEFAULT;
+  }
+  if (button != IUP_BUTTON1) return IUP_DEFAULT;
+  grid_go(ih, pos, !d->marks ? GRID_PLAIN : iup_iscontrol(status) ? GRID_TOGGLE : iup_isshift(status) ? GRID_EXTEND : GRID_PLAIN);
+  if (iup_isdouble(status)) grid_activate(ih, pos, "double");
+  return IUP_DEFAULT;
+}
+
+static void grid_set_hover(Ihandle* ih, int pos)
+{
+  struct _IcontrolData* d = ih->data;
+  int before = d->hover;
+  if (pos == before) return;
+  d->hover = pos;
+  grid_touch(ih, before);
+  grid_touch(ih, pos);
+}
+static int grid_motion(Ihandle* ih, int x, int y, char* status)
+{
+  (void)status;
+  iupFlatScrollBarMotionUpdate(ih, x, y);
+  grid_set_hover(ih, grid_hit(ih, x, y));
+  return IUP_DEFAULT;
+}
+static int grid_leave(Ihandle* ih) { grid_set_hover(ih, 0); return IUP_DEFAULT; }
+static int grid_focus(Ihandle* ih, int focus)
+{
+  ih->data->focused = focus;
+  grid_touch(ih, ih->data->cursor);
+  return IUP_DEFAULT;
+}
+static int grid_wheel(Ihandle* ih, float delta)
+{
+  struct _IcontrolData* d = ih->data;
+  if (d->horizontal)
+  {
+    int next = grid_scroll(ih) - (int)(delta * (d->pitch / 3));
+    grid_set_scroll(ih, grid_max(grid_min(next, grid_total(ih) - grid_extent(ih)), 0));
+    iupdrvRedrawNow(ih);
+  }
+  else
+    iupFlatScrollBarWheelUpdate(ih, delta);
+  return IUP_DEFAULT;
+}
+static int grid_scrolled(Ihandle* ih, int op, float posx, float posy)
+{
+  (void)op; (void)posx; (void)posy;
+  iupdrvRedrawNow(ih);
+  return IUP_DEFAULT;
+}
+static int grid_resize(Ihandle* ih, int w, int h) { (void)w; (void)h; grid_refresh(ih); return IUP_DEFAULT; }
+
+/* ---- attributes ----------------------------------------------------------------------- */
+
+static int grid_set_count(Ihandle* ih, const char* value)
+{
+  struct _IcontrolData* d = ih->data;
+  int n = value ? atoi(value) : 0;
+  d->count = n > 0 ? n : 0;
+  if (d->cursor > d->count) d->cursor = 0;
+  if (d->anchor > d->count) d->anchor = 0;
+  if (d->hover > d->count) d->hover = 0;
+  grid_alloc_marks(ih);
+  grid_refresh(ih);
+  return 0;
+}
+static char* grid_get_count(Ihandle* ih) { return iupStrReturnInt(ih->data->count); }
+static int grid_set_value(Ihandle* ih, const char* value)
+{
+  struct _IcontrolData* d = ih->data;
+  int pos = value ? atoi(value) : 0, before = d->cursor;
+  d->cursor = d->anchor = pos >= 1 && pos <= d->count ? pos : 0;
+  if (d->marks)
+  {
+    grid_mark_all(ih, 0);
+    if (d->cursor) grid_mark(ih, d->cursor, 1);
+    if (ih->handle) iupdrvPostRedraw(ih);
+  }
+  else { grid_touch(ih, before); grid_touch(ih, d->cursor); }
+  return 0;
+}
+static char* grid_get_value(Ihandle* ih) { return iupStrReturnInt(ih->data->cursor); }
+static char* grid_get_accessible(Ihandle* ih)
+{
+  int pos = ih->data->cursor;
+  return pos ? grid_value(ih, "TITLE", pos) : NULL;
+}
+static char* grid_get_idvalue(Ihandle* ih, int pos) { return grid_value(ih, "TITLE", pos); }
+static int grid_set_scrollto(Ihandle* ih, const char* value)
+{
+  struct _IcontrolData* d = ih->data;
+  int pos = value ? atoi(value) : 0;
+  if (pos < 1 || pos > d->count) return 0;
+  grid_set_scroll(ih, grid_max(grid_min((pos - 1) / d->lanes * d->pitch, grid_total(ih) - grid_extent(ih)), 0));
+  if (ih->handle) iupdrvPostRedraw(ih);
+  return 0;
+}
+static int grid_set_redrawcell(Ihandle* ih, const char* value) { grid_touch(ih, value ? atoi(value) : 0); return 0; }
+static char* grid_get_visiblerange(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  int first, last;
+  if (!d->count) return NULL;
+  first = grid_max(grid_scroll(ih) - d->padding, 0) / d->pitch * d->lanes + 1;
+  last = grid_min(((grid_scroll(ih) + grid_extent(ih)) / d->pitch + 1) * d->lanes, d->count);
+  return iupStrReturnStrf("%d:%d", first, last);
+}
+static char* grid_get_hover(Ihandle* ih) { return iupStrReturnInt(ih->data->hover); }
+static char* grid_get_selectedcount(Ihandle* ih)
+{
+  return iupStrReturnInt(ih->data->marks ? ih->data->marked : (ih->data->cursor ? 1 : 0));
+}
+/* One character per cell, as IupList reports a multiple selection. */
+static char* grid_get_selectionmask(Ihandle* ih)
+{
+  struct _IcontrolData* d = ih->data;
+  int pos;
+  char* mask;
+  if (!d->count) return NULL;
+  mask = iupStrGetMemory(d->count + 1);
+  for (pos = 1; pos <= d->count; pos++) mask[pos - 1] = grid_is_marked(ih, pos) ? '+' : '-';
+  mask[d->count] = 0;
+  return mask;
+}
+static int grid_set_multiple(Ihandle* ih, const char* value)
+{
+  iupAttribSetStr(ih, "MULTIPLE", value);
+  grid_alloc_marks(ih);
+  return 1;
+}
+#define GRID_LAYOUT_ATTRIB(_fn, _name) \
+  static int _fn(Ihandle* ih, const char* value) \
+  { iupAttribSetStr(ih, _name, value); grid_refresh(ih); return 1; }  /* 0 would drop it at map */
+GRID_LAYOUT_ATTRIB(grid_set_cellwidth, "CELLWIDTH")
+GRID_LAYOUT_ATTRIB(grid_set_aspect, "ASPECT")
+GRID_LAYOUT_ATTRIB(grid_set_gutter, "GUTTER")
+GRID_LAYOUT_ATTRIB(grid_set_padding, "PADDING")
+GRID_LAYOUT_ATTRIB(grid_set_rows, "ROWS")
+GRID_LAYOUT_ATTRIB(grid_set_orientation, "ORIENTATION")
+GRID_LAYOUT_ATTRIB(grid_set_showtext, "SHOWTEXT")
+static int grid_post_redraw(Ihandle* ih, const char* value) { (void)value; if (ih->handle) iupdrvPostRedraw(ih); return 1; }
+static int grid_set_scrollbar(Ihandle* ih, const char* value)
+{
+  if (ih->handle) return IUP_DEFAULT;
+  if (value && !iupStrEqualNoCase(value, "NO") && iupFlatScrollBarCreate(ih))
+  {
+    IupSetAttribute(ih, "SCROLLBAR", "NO");
+    IupSetCallback(ih, "WHEEL_CB", (Icallback)grid_wheel);
+  }
+  return 1;
+}
+static void grid_size(Ihandle* ih, int* w, int* h, int* expand)
+{
+  grid_measure(ih);
+  *w = ih->data->cellw * 2 + ih->data->gutter + 2 * ih->data->padding;
+  *h = ih->data->cellh + 2 * ih->data->padding;
+  (void)expand;
+}
+static void grid_child_size(Ihandle* ih, int shrink) { if (iupFlatScrollBarGet(ih)) iupFlatScrollBarSetChildrenCurrentSize(ih, shrink); }
+static void grid_child_pos(Ihandle* ih, int x, int y) { if (iupFlatScrollBarGet(ih)) iupFlatScrollBarSetChildrenPosition(ih); (void)x; (void)y; }
+static void grid_destroy(Ihandle* ih)
+{
+  free(ih->data->marks);
+  free(ih->data->corners);
+  iupFlatScrollBarRelease(ih);
+}
+static int grid_create(Ihandle* ih, void** params)
+{
+  free(ih->data); ih->data = iupALLOCCTRLDATA(); (void)params;
+  ih->data->lanes = 1; ih->data->pitch = 1;
+  IupSetAttribute(ih, "EXPAND", "YES"); IupSetAttribute(ih, "SCROLLBAR", "VERTICAL");
+  IupSetCallback(ih, "ACTION", (Icallback)grid_redraw);
+  IupSetCallback(ih, "BUTTON_CB", (Icallback)grid_button);
+  IupSetCallback(ih, "MOTION_CB", (Icallback)grid_motion);
+  IupSetCallback(ih, "LEAVEWINDOW_CB", (Icallback)grid_leave);
+  IupSetCallback(ih, "FOCUS_CB", (Icallback)grid_focus);
+  IupSetCallback(ih, "RESIZE_CB", (Icallback)grid_resize);
+  IupSetCallback(ih, "SCROLL_CB", (Icallback)grid_scrolled);
+  IupSetCallback(ih, "K_ANY", (Icallback)grid_key);
+  return IUP_NOERROR;
+}
+IUP_API Ihandle* IupFlatGrid(void) { return IupCreate("flatgrid"); }
+Iclass* iupFlatGridNewClass(void)
+{
+  Iclass* ic = iupClassNew(iupRegisterFindClass("canvas"));
+  ic->name = "flatgrid"; ic->cons = "FlatGrid"; ic->nativetype = IUP_TYPECANVAS;
+  ic->childtype = IUP_CHILDNONE; ic->is_interactive = 1; ic->has_attrib_id = 1;
+  ic->New = iupFlatGridNewClass; ic->Create = grid_create; ic->Destroy = grid_destroy;
+  ic->ComputeNaturalSize = grid_size; ic->SetChildrenCurrentSize = grid_child_size; ic->SetChildrenPosition = grid_child_pos;
+  iupClassRegisterReplaceAttribDef(ic, "BORDER", "NO", NULL);
+  iupClassRegisterCallback(ic, "CELLVALUE_CB", "is=s");
+  iupClassRegisterCallback(ic, "CELLBITS_CB", "iiiV=V");
+  iupClassRegisterCallback(ic, "CELL_ACTION_CB", "i");
+  iupClassRegisterCallback(ic, "CELL_ACTIVATE_CB", "is");
+  iupClassRegisterCallback(ic, "CELL_CONTEXT_CB", "is");
+  iupClassRegisterCallback(ic, "TYPEAHEAD_CB", "s");
+  iupClassRegisterCallback(ic, "VALUECHANGED_CB", "");
+  iupClassRegisterAttribute(ic, "COUNT", grid_get_count, grid_set_count, "0", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "VALUE", grid_get_value, grid_set_value, "0", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "CELLWIDTH", NULL, grid_set_cellwidth, "150", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "ASPECT", NULL, grid_set_aspect, "2:3", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "GUTTER", NULL, grid_set_gutter, "16", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "PADDING", NULL, grid_set_padding, "16", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "ROWS", NULL, grid_set_rows, "1", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "ORIENTATION", NULL, grid_set_orientation, "VERTICAL", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "SHOWTEXT", NULL, grid_set_showtext, "YES", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "MULTIPLE", NULL, grid_set_multiple, "NO", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "SCROLLTO", NULL, grid_set_scrollto, NULL, NULL, IUPAF_WRITEONLY|IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "REDRAWCELL", NULL, grid_set_redrawcell, NULL, NULL, IUPAF_WRITEONLY|IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "VISIBLERANGE", grid_get_visiblerange, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "HOVER", grid_get_hover, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "SELECTEDCOUNT", grid_get_selectedcount, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "SELECTIONMASK", grid_get_selectionmask, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "ACCESSIBLEVALUE", grid_get_accessible, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "VALUESTRING", grid_get_accessible, NULL, NULL, NULL, IUPAF_READONLY|IUPAF_NO_INHERIT);
+  iupClassRegisterAttributeId(ic, "IDVALUE", grid_get_idvalue, NULL, IUPAF_READONLY|IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "FGCOLOR", NULL, grid_post_redraw, IUP_FLAT_FORECOLOR, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "BGCOLOR", NULL, grid_post_redraw, IUP_FLAT_BACKCOLOR, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "SECONDARYCOLOR", NULL, grid_post_redraw, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "PLACEHOLDERCOLOR", NULL, grid_post_redraw, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "HLCOLOR", NULL, grid_post_redraw, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "ITEMMARKERCOLOR", NULL, grid_post_redraw, NULL, NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "ITEMRADIUS", NULL, grid_post_redraw, "6", NULL, IUPAF_DEFAULT);
+  iupClassRegisterAttribute(ic, "FOCUSFEEDBACK", NULL, NULL, "YES", NULL, IUPAF_NO_INHERIT);
+  iupClassRegisterAttribute(ic, "FLATSCROLLBAR", NULL, grid_set_scrollbar, "YES", NULL, IUPAF_NOT_MAPPED|IUPAF_NO_INHERIT);
+  iupFlatScrollBarRegister(ic);
+  return ic;
+}
