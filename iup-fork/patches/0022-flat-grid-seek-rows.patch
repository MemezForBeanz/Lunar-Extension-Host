+void iupdrvDrawBitsWDL(IdrawCanvas* dc, const unsigned char* bgra, int w, int h, int stride, int x, int y)
+{
+  /* The buffer format is bottom-up. Slow, and only for a canvas forced to Direct2D. */
+  unsigned char* flipped = malloc((size_t)w * h * 4);
+  if (flipped)
+  {
+    WD_HIMAGE hImage;
+    WD_RECT rect;
+    int row;
+    for (row = 0; row < h; row++)
+      memcpy(flipped + (size_t)(h - 1 - row) * w * 4, bgra + (size_t)row * stride, (size_t)w * 4);
+    hImage = wdCreateImageFromBuffer(w, h, w * 4, flipped, WD_PIXELFORMAT_B8G8R8A8, NULL, 0);
+    if (hImage)
+    {
+      rect.x0 = iupInt2Float(x);
+      rect.y0 = iupInt2Float(y);
+      rect.x1 = iupInt2Float(x + w);
+      rect.y1 = iupInt2Float(y + h);
+      wdBitBltImage(dc->hCanvas, hImage, &rect, NULL);
+      wdDestroyImage(hImage);
+    }
+    free(flipped);
+  }
+}
