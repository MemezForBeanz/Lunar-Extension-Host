+/* Store before refreshing: unlike TABTYPE (which only posts a redraw), this
+   attribute changes the space available to every child immediately. */
+static int iFlatTabsSetShowTabsAttrib(Ihandle* ih, const char* value)
+{
+  /* Return 1 (store) in every path: the mapping process re-applies each stored
+     attribute through its setter (iupAttribUpdate) and REMOVES it from the
+     hash when the setter answers 0 -- which turned a SHOWTABS=NO set before
+     map back into the YES default, silently re-showing the strip. */
+  int show = value ? iupStrBoolean(value) : 1;
+  if (iupAttribGetBoolean(ih, "SHOWTABS") == show)
+    return 1;
+
+  iupAttribSet(ih, "SHOWTABS", show ? "YES" : "NO");
+  iupAttribSetInt(ih, "_IUPFTABS_HIGHLIGHTED", ITABS_NONE);
+  iupAttribSetInt(ih, "_IUPFTABS_CLOSEHIGH", ITABS_NONE);
+  iupAttribSetInt(ih, "_IUPFTABS_CLOSEPRESS", ITABS_NONE);
+  iupAttribSetInt(ih, "_IUPFTABS_EXTRAPRESS", ITABS_NONE);
+  if (ih->handle)
+  {
+    Ihandle* child = iFlatTabsGetCurrentTab(ih);
+    iupFlatItemResetTip(ih);
+    IupRefresh(ih);
+    if (show && child)
+      iFlatTabsUpdateScrollPos(ih, child);
+    iupdrvPostRedraw(ih);
+  }
+  return 1;
+}
